-- ⚡ RARE FEATURE 1: PHANTOM REWIND (Time Travel)
-- Records position continuously. When triggered, rewinds you 4 seconds to escape death.
RunService.Heartbeat:Connect(function()
    local char = localPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        table.insert(positionHistory, char.HumanoidRootPart.CFrame)
        if #positionHistory > 40 then -- Keeps roughly 4 seconds of history
            table.remove(positionHistory, 1)
        end
    end
end)

local function triggerPhantomRewind()
    local char = localPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") and #positionHistory > 0 then
        -- Apply a glitch effect
        local hl = Instance.new("Highlight", char)
        hl.FillColor = Color3.new(0, 1, 1)
        
        -- Teleport to oldest recorded position
        char.HumanoidRootPart.CFrame = positionHistory[1]
        positionHistory = {} -- Reset history after jump
        
        task.delay(0.5, function() hl:Destroy() end)
    end
end

-- ⚡ RARE FEATURE 2: AUTO-RETALIATE SPHERE
-- Instantly teleports you behind any enemy that enters your 20-stud radius, attacks, and returns you.
RunService.Stepped:Connect(function()
    if not autoRetaliateEnabled then return end
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local myRoot = char.HumanoidRootPart

    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local enemyRoot = player.Character.HumanoidRootPart
            local dist = (myRoot.Position - enemyRoot.Position).Magnitude
            
            if dist < 20 and dist > 5 then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then
                    local originalCFrame = myRoot.CFrame
                    -- Teleport behind enemy
                    myRoot.CFrame = enemyRoot.CFrame * CFrame.new(0, 0, 4)
                    tool:Activate()
                    task.wait(0.1)
                    -- Teleport back seamlessly
                    myRoot.CFrame = originalCFrame
                end
            end
        end
    end
end)

-- SHADOW STRIKE BLINK
local function executeShadowStrike()
    local char = localPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local targetRoot = getClosestEnemyToCenter()
    if not targetRoot or not targetRoot.Character then return end
    
    local safePosition = root.CFrame
    root.CFrame = targetRoot.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
    
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then tool:Activate() end
    
    task.wait(0.2)
    root.CFrame = safePosition
end

