local function applyHitbox(character)
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    local partsToAdjust = humanoid.RigType == Enum.HumanoidRigType.R15 
        and {"UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg", "Head", "HumanoidRootPart"} 
        or {"HumanoidRootPart", "Head"}
    
    for _, partName in ipairs(partsToAdjust) do
        local part = character:FindFirstChild(partName)
        if part then
            if not part:FindFirstChild("OriginalSize") then
                local originalSize = Instance.new("Vector3Value")
                originalSize.Name = "OriginalSize"
                originalSize.Value = part.Size
                originalSize.Parent = part
            end
            part.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
            part.Transparency = hitboxTransparency
            part.BrickColor = BrickColor.new("Dark red")
            part.Material = Enum.Material.ForceField
            part.CanCollide = false
            if part.Name == "Head" then part.Massless = true end
        end
    end
end

local function resetHitbox(character)
    if not character then return end
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") and part:FindFirstChild("OriginalSize") then
            part.Size = part.OriginalSize.Value
            part.Transparency = 1
            part.BrickColor = BrickColor.new("Medium stone grey")
            part.Material = Enum.Material.Plastic
            part.CanCollide = true
            if part.Name == "Head" then part.Massless = false end
        end
    end
end

local function toggleHitboxes(enabled)
    hitboxEnabled = enabled
    if enabled then
        if not hitboxCoroutine then
            hitboxCoroutine = coroutine.create(function()
                while hitboxEnabled and task.wait(0.5) do
                    for _, player in ipairs(Players:GetPlayers()) do
                        if isEnemy(player) and player.Character then applyHitbox(player.Character) end
                    end
                end
            end)
            coroutine.resume(hitboxCoroutine)
        end
    else
        if hitboxCoroutine then coroutine.close(hitboxCoroutine); hitboxCoroutine = nil end
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character then resetHitbox(player.Character) end
        end
    end
end

local function updateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if not espGuis[player] then
                local hl = Instance.new("Highlight")
                hl.Name = "ESP_Highlight"
                hl.FillColor = Color3.new(1, 0, 0)
                hl.OutlineColor = Color3.new(1, 1, 1)
                hl.FillTransparency = 0.5
                hl.OutlineTransparency = 0
                hl.Parent = player.Character
                espGuis[player] = hl
            else
                espGuis[player].Parent = player.Character
            end
        elseif espGuis[player] then
            espGuis[player]:Destroy()
            espGuis[player] = nil
        end
    end
end

local function getClosestEnemyToCenter()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local pos = player.Character.HumanoidRootPart.Position
                local vector, onScreen = camera:WorldToViewportPoint(pos)
                if onScreen then
                    local distance = (screenCenter - Vector2.new(vector.X, vector.Y)).Magnitude
                    if distance < shortestDistance then
                        closestPlayer = player
                        shortestDistance = distance
                    end
                end
            end
        end
    end
    return closestPlayer
end

local function toggleFly(enabled)
    flyEnabled = enabled
    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    if rootPart then
        if rootPart:FindFirstChild("FlyGyro") then rootPart.FlyGyro:Destroy() end
        if rootPart:FindFirstChild("FlyVelocity") then rootPart.FlyVelocity:Destroy() end
    end
    if humanoid then humanoid.PlatformStand = false end
    
    if enabled and rootPart and humanoid then
        local bodyGyro = Instance.new("BodyGyro", rootPart)
        bodyGyro.Name = "FlyGyro"
        bodyGyro.P = 9e4
        bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bodyGyro.CFrame = rootPart.CFrame
        
        local bodyVelocity = Instance.new("BodyVelocity", rootPart)
        bodyVelocity.Name = "FlyVelocity"
        bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bodyVelocity.Velocity = Vector3.zero
        
        humanoid.PlatformStand = true
        
        flyConnection = RunService.RenderStepped:Connect(function()
            if not character.Parent or humanoid.Health <= 0 then toggleFly(false) return end
            local moveDir = humanoid.MoveDirection
            bodyGyro.CFrame = camera.CFrame
            
            if moveDir.Magnitude > 0 then
                local flatCam = CFrame.new(Vector3.zero, Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z))
                local localMove = flatCam:VectorToObjectSpace(moveDir)
                bodyVelocity.Velocity = camera.CFrame:VectorToWorldSpace(localMove) * flySpeed
            else
                bodyVelocity.Velocity = Vector3.zero
            end
        end)
    end
end

local function updatePreCog()
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local root = player.Character.HumanoidRootPart
            
            if not trajectoryBeams[player] then
                local att0 = Instance.new("Attachment", root)
                local att1 = Instance.new("Attachment", root)
                
                local beam = Instance.new("Beam", root)
                beam.Attachment0 = att0
                beam.Attachment1 = att1
                beam.Color = ColorSequence.new(Color3.new(1, 0, 0), Color3.new(1, 1, 0))
                beam.FaceCamera = true
                beam.Width0 = 0.2
                beam.Width1 = 0.05
                beam.LightEmission = 1
                beam.Transparency = NumberSequence.new(0, 1)
                
                trajectoryBeams[player] = {att0 = att0, att1 = att1, beam = beam}
            else
                local velocity = root.AssemblyLinearVelocity
                if velocity.Magnitude > 1 then
                    trajectoryBeams[player].att1.Position = Vector3.new(velocity.X * 0.75, velocity.Y * 0.75, velocity.Z * 0.75)
                    trajectoryBeams[player].beam.Enabled = true
                else
                    trajectoryBeams[player].beam.Enabled = false
                end
            end
        elseif trajectoryBeams[player] then
            trajectoryBeams[player].att0:Destroy()
            trajectoryBeams[player].att1:Destroy()
            trajectoryBeams[player].beam:Destroy()
            trajectoryBeams[player] = nil
        end
    end
end

local function toggleDomain(state)
    domainEnabled = state
    if state then
        Lighting.Ambient = Color3.new(0, 0, 0)
        Lighting.OutdoorAmbient = Color3.new(0, 0, 0)
        Lighting.Brightness = 0
        Lighting.ClockTime = 0
        Lighting.FogEnd = 500
        Lighting.FogColor = Color3.new(0, 0, 0)
        
        for _, player in ipairs(Players:GetPlayers()) do
            if isEnemy(player) and player.Character then
                local hl = Instance.new("Highlight")
                hl.Name = "VoidGlow"
                hl.FillColor = Color3.new(1, 1, 1)
                hl.OutlineColor = Color3.new(1, 0, 0)
                hl.FillTransparency = 0.2
                hl.OutlineTransparency = 0
                hl.Parent = player.Character
            end
        end
    else
        Lighting.Ambient = originalLighting.Ambient
        Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
        Lighting.Brightness = originalLighting.Brightness
        Lighting.ClockTime = originalLighting.ClockTime
        Lighting.FogEnd = originalLighting.FogEnd
        Lighting.FogColor = originalLighting.FogColor
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character and player.Character:FindFirstChild("VoidGlow") then
                player.Character.VoidGlow:Destroy()
            end
        end
    end
end

