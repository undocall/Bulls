local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")

local localPlayer = Players.LocalPlayer
while not localPlayer do task.wait() localPlayer = Players.LocalPlayer end

-- State
local phantomDodgeEnabled = false
local autoAuraEnabled = false
local isDodging = false

-- ==============================================
-- 1. BADASS FEATURE: AFTERIMAGE DECOY DODGE
-- ==============================================
local function createAfterimage(char)
    pcall(function()
        char.Archivable = true
        local clone = char:Clone()
        
        -- Strip scripts and logic from clone to prevent lag
        for _, v in ipairs(clone:GetDescendants()) do
            if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("Sound") then
                v:Destroy()
            elseif v:IsA("BasePart") then
                v.Anchored = true
                v.CanCollide = false
                v.Material = Enum.Material.Neon
                v.Color = Color3.fromRGB(0, 255, 255) -- Glowing Cyan Decoy
                
                -- Add particle shatter effect
                local particle = Instance.new("ParticleEmitter")
                particle.Texture = "rbxassetid://243098098"
                particle.Color = ColorSequence.new(Color3.fromRGB(0, 255, 255))
                particle.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0)})
                particle.Lifetime = NumberRange.new(0.5, 1)
                particle.Rate = 0
                particle.Parent = v
                
                task.delay(0.5, function()
                    particle:Emit(20)
                    v.Transparency = 1
                end)
            end
        end
        
        clone.Parent = workspace
        task.delay(1.5, function() clone:Destroy() end)
    end)
end

RunService.Heartbeat:Connect(function()
    if not phantomDodgeEnabled or isDodging then return end
    
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local myRoot = char.HumanoidRootPart

    for _, enemy in ipairs(Players:GetPlayers()) do
        if enemy ~= localPlayer and enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") then
            local enemyRoot = enemy.Character.HumanoidRootPart
            local dist = (myRoot.Position - enemyRoot.Position).Magnitude
            
            -- If enemy is close AND moving fast towards you (Charging)
            if dist < 18 and enemyRoot.AssemblyLinearVelocity.Magnitude > 15 then
                isDodging = true
                
                -- 1. Create the glowing clone decoy
                createAfterimage(char)
                
                -- 2. Snap behind the charging enemy
                local backstabPosition = enemyRoot.CFrame * CFrame.new(0, 0, 5)
                myRoot.CFrame = backstabPosition
                
                -- 3. Auto swing weapon
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then tool:Activate() end
                
                -- Cooldown to prevent spam
                task.wait(1.5)
                isDodging = false
                break
            end
        end
    end
end)

-- ==============================================
-- 2. FIXED FEATURE: MAGNET AURA (SAFE HITBOX)
-- ==============================================
-- Standard hitboxes break your game. This magnetically pulls enemies to your attacks locally.
RunService.Stepped:Connect(function()
    if not autoAuraEnabled then return end
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end -- Only works when holding a weapon

    for _, enemy in ipairs(Players:GetPlayers()) do
        if enemy ~= localPlayer and enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") then
            local myRoot = char.HumanoidRootPart
            local enemyRoot = enemy.Character.HumanoidRootPart
            
            if (myRoot.Position - enemyRoot.Position).Magnitude < 25 then
                -- Drags their hitbox to your blade without resizing them and crashing
                enemyRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -3)
                tool:Activate()
            end
        end
    end
end)

-- ==============================================
-- 3. CUSTOM MOBILE UI (BOTTOM LEFT, PAST JOYSTICK)
-- ==============================================
local function createUI()
    if CoreGui:FindFirstChild("PhantomUI") then CoreGui.PhantomUI:Destroy() end
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "PhantomUI"
    screenGui.ResetOnSpawn = false
    -- Try to parent to CoreGui (Exploit), fallback to PlayerGui (Studio)
    local success = pcall(function() screenGui.Parent = CoreGui end)
    if not success then screenGui.Parent = localPlayer:WaitForChild("PlayerGui") end

    -- Main Panel Frame
    local frame = Instance.new("Frame", screenGui)
    frame.Size = UDim2.new(0, 140, 0, 100)
    -- X: 0.22 (Avoids left joystick), Y: 0.65 (Bottom left area)
    frame.Position = UDim2.new(0.22, 0, 0.65, 0)
    frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true -- You can still drag it if needed

    local uiCorner = Instance.new("UICorner", frame)
    uiCorner.CornerRadius = UDim.new(0, 8)
    
    local uiStroke = Instance.new("UIStroke", frame)
    uiStroke.Color = Color3.fromRGB(0, 255, 255)
    uiStroke.Thickness = 2

    -- Title
    local title = Instance.new("TextLabel", frame)
    title.Size = UDim2.new(1, 0, 0, 25)
    title.BackgroundTransparency = 1
    title.Text = "⚡ PHANTOM"
    title.TextColor3 = Color3.fromRGB(0, 255, 255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 14

    -- Helper function to make toggle buttons
    local function createToggle(name, yPos, callback)
        local btn = Instance.new("TextButton", frame)
        btn.Size = UDim2.new(0.9, 0, 0, 30)
        btn.Position = UDim2.new(0.05, 0, 0, yPos)
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        btn.Text = "OFF | " .. name
        btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        btn.Font = Enum.Font.GothamSemibold
        btn.TextSize = 12
        
        local corner = Instance.new("UICorner", btn)
        corner.CornerRadius = UDim.new(0, 4)
        
        local toggled = false
        btn.MouseButton1Click:Connect(function()
            toggled = not toggled
            if toggled then
                btn.BackgroundColor3 = Color3.fromRGB(0, 150, 150)
                btn.Text = "ON | " .. name
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                btn.Text = "OFF | " .. name
                btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
            callback(toggled)
        end)
    end

    -- Create the two small buttons
    createToggle("Decoy Dodge", 30, function(state) phantomDodgeEnabled = state end)
    createToggle("Magnet Aura", 65, function(state) autoAuraEnabled = state end)
end

createUI()
