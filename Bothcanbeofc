-- Anti-Fling (Stops you from being flung by removing local collisions with enemies)
uiLibrary:AddToggle("Anti-Fling", function(enabled)
    antiFlingEnabled = enabled
    playSound("rbxassetid://12221976")
    
    if enabled then
        antiFlingConnection = RunService.Heartbeat:Connect(function()
            local char = localPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not char or not root then return end
            
            -- Prevent self rotational velocity spikes
            root.AssemblyAngularVelocity = Vector3.zero
            if not flyEnabled and root.AssemblyLinearVelocity.Magnitude > 200 then
                root.AssemblyLinearVelocity = Vector3.zero
            end
            
            -- Disable collisions on all enemy character parts relative to local player
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= localPlayer and player.Character then
                    for _, part in ipairs(player.Character:GetChildren()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                            part.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                end
            end
        end)
    else
        if antiFlingConnection then
            antiFlingConnection:Disconnect()
            antiFlingConnection = nil
        end
    end
end, false)

-- Attack Power Multiplier Toggle
uiLibrary:AddToggle("Attack Power", function(enabled)
    attackPowerEnabled = enabled
    playSound("rbxassetid://12221976")
    
    if enabled then
        attackPowerConnection = RunService.Heartbeat:Connect(function()
            if not attackPowerEnabled then return end
            
            local char = localPlayer.Character
            if not char then return end
            
            local tool = char:FindFirstChildOfClass("Tool")
            if not tool then return end
            
            local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
            if not handle then return end
            
            -- Multi-hit trigger loop based on configured attackPower level
            for _, player in ipairs(Players:GetPlayers()) do
                if isEnemy(player) and player.Character then
                    local enemyRoot = player.Character:FindFirstChild("HumanoidRootPart")
                    if enemyRoot then
                        local distance = (enemyRoot.Position - handle.Position).Magnitude
                        if distance <= (hitboxSize + 2) then
                            local hitCount = math.clamp(math.floor(attackPower / 10), 2, 10)
                            for i = 1, hitCount do
                                if firetouchinterest then
                                    firetouchinterest(handle, enemyRoot, 0)
                                    firetouchinterest(handle, enemyRoot, 1)
                                end
                            end
                        end
                    end
                end
            end
        end)
    else
        if attackPowerConnection then
            attackPowerConnection:Disconnect()
            attackPowerConnection = nil
        end
    end
end, false)

