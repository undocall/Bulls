-- ==============================================
-- ⚡ HITBLOX V6: ISLAND BRAWLER "INTIMIDATOR" BUILD
-- ==============================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local localPlayer = Players.LocalPlayer
while not localPlayer do task.wait() localPlayer = Players.LocalPlayer end
local camera = workspace.CurrentCamera

-- ==============================================
-- State Variables
-- ==============================================
local states = {
    Fly = false,
    Hitbox = false,
    ESP = false,
    Noclip = false,
    AimLock = false,
    MeteorDive = false,
    BrawlMagnet = false,
    ShockwaveAura = false
}

local hitboxSize = 25 -- Massive threat range
local espGuis = {}
local flyConnection = nil
local noclipConnection = nil
local aimLockConnection = nil
local flySpeed = 50
local isMeteorStriking = false

-- ==============================================
-- Helper Functions
-- ==============================================
local function getClosestEnemy()
    local closest, shortest = nil, math.huge
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local myRoot = char.HumanoidRootPart

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local dist = (p.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude
                if dist < shortest then closest, shortest = p, dist end
            end
        end
    end
    return closest
end

-- ==============================================
-- 1. BADASS FEATURE: SHOCKWAVE PERIMETER AURA
-- Pushes enemies away automatically if they get too close to your ledge
-- ==============================================
RunService.Heartbeat:Connect(function()
    if not states.ShockwaveAura then return end
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local myRoot = char.HumanoidRootPart

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local enemyRoot = p.Character.HumanoidRootPart
            local dist = (myRoot.Position - enemyRoot.Position).Magnitude
            
            -- If someone approaches within 16 studs to attack you
            if dist < 16 then
                -- Violently fling them backward away from you
                local awayDir = (enemyRoot.Position - myRoot.Position).Unit
                enemyRoot.AssemblyLinearVelocity = (awayDir + Vector3.new(0, 0.5, 0)) * 120
            end
        end
    end
end)

-- ==============================================
-- 2. BADASS FEATURE: ANTI-VOID METEOR DIVE
-- ==============================================
RunService.Heartbeat:Connect(function()
    if not states.MeteorDive or isMeteorStriking then return end
    
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    if hrp.Velocity.Y < -65 then
        isMeteorStriking = true
        hrp.Velocity = Vector3.zero
        hrp.CFrame = hrp.CFrame + Vector3.new(0, 300, 0)
        
        local fire = Instance.new("Fire", hrp)
        fire.Size = 20
        fire.Color = Color3.fromRGB(255, 50, 0)
        
        hrp.Anchored = true
        task.wait(0.4)
        hrp.Anchored = false
        
        local target = getClosestEnemy()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            hrp.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 4, 0)
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then tool:Activate() end
        end
        
        task.wait(0.5)
        if fire then fire:Destroy() end
        task.wait(1.5)
        isMeteorStriking = false
    end
end)

-- ==============================================
-- 3. FLOATING ISLAND BRAWL MAGNET & HITBOXES
-- ==============================================
RunService.Stepped:Connect(function()
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local myRoot = char.HumanoidRootPart
    local tool = char:FindFirstChildOfClass("Tool")

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character then
            local enemyRoot = p.Character:FindFirstChild("HumanoidRootPart")
            if enemyRoot then
                -- Hitbox Expansion
                if not enemyRoot:FindFirstChild("OgSize") then
                    local og = Instance.new("Vector3Value", enemyRoot)
                    og.Name = "OgSize"
                    og.Value = enemyRoot.Size
                end
                
                if states.Hitbox then
                    enemyRoot.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                    enemyRoot.Transparency = 0.8
                    enemyRoot.BrickColor = BrickColor.new("Dark red")
                    enemyRoot.Material = Enum.Material.ForceField
                    enemyRoot.CanCollide = false
                else
                    enemyRoot.Size = enemyRoot.OgSize.Value
                    enemyRoot.Transparency = 1
                    enemyRoot.CanCollide = true
                end

                -- Brawl Magnet (Drags them into your swings automatically)
                if states.BrawlMagnet and tool and (myRoot.Position - enemyRoot.Position).Magnitude < 35 then
                    enemyRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -3)
                    tool:Activate()
                end
            end
        end
    end
end)

-- ==============================================
-- 4. CORE SYSTEMS (Fly, ESP, Noclip, AimLock)
-- ==============================================
local function toggleFly(state)
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if state then
        hum.PlatformStand = true
        local bg = Instance.new("BodyGyro", hrp)
        bg.P = 9e4
        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.CFrame = hrp.CFrame
        
        local bv = Instance.new("BodyVelocity", hrp)
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Velocity = Vector3.zero

        flyConnection = RunService.RenderStepped:Connect(function()
            if not char.Parent or hum.Health <= 0 then states.Fly = false return end
            bg.CFrame = camera.CFrame
            local moveDir = hum.MoveDirection
            if moveDir.Magnitude > 0 then
                local flatCam = CFrame.new(Vector3.zero, Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z))
                bv.Velocity = camera.CFrame:VectorToWorldSpace(flatCam:VectorToObjectSpace(moveDir)) * flySpeed
            else
                bv.Velocity = Vector3.zero
            end
        end)
    else
        hum.PlatformStand = false
        if hrp:FindFirstChildOfClass("BodyGyro") then hrp:FindFirstChildOfClass("BodyGyro"):Destroy() end
        if hrp:FindFirstChildOfClass("BodyVelocity") then hrp:FindFirstChildOfClass("BodyVelocity"):Destroy() end
        if flyConnection then flyConnection:Disconnect() end
    end
end

RunService.RenderStepped:Connect(function()
    if states.ESP then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer and p.Character then
                if not espGuis[p] then
                    local hl = Instance.new("Highlight")
                    hl.FillColor = Color3.new(1, 0, 0)
                    hl.FillTransparency = 0.5
                    hl.Parent = p.Character
                    espGuis[p] = hl
                else
                    espGuis[p].Parent = p.Character
                end
            end
        end
    else
        for _, gui in pairs(espGuis) do gui:Destroy() end
        espGuis = {}
    end

    if states.AimLock then
        local target = getClosestEnemy()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position, target.Character.HumanoidRootPart.Position), 0.5)
        end
    end
end)

-- ==============================================
-- 5. COMPACT MOBILE UI (Bottom Left, Clear of Joystick)
-- ==============================================
local function createUI()
    if CoreGui:FindFirstChild("BrawlUI") then CoreGui.BrawlUI:Destroy() end
    
    local gui = Instance.new("ScreenGui")
    gui.Name = "BrawlUI"
    gui.ResetOnSpawn = false
    pcall(function() gui.Parent = CoreGui end)
    if gui.Parent == nil then gui.Parent = localPlayer:WaitForChild("PlayerGui") end

    local frame = Instance.new("Frame", gui)
    frame.Size = UDim2.new(0, 150, 0, 260)
    frame.Position = UDim2.new(0.20, 0, 0.50, 0) -- Safely above mobile movement joystick
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    frame.BackgroundTransparency = 0.15
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true

    local corner = Instance.new("UICorner", frame) corner.CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke", frame) stroke.Color = Color3.fromRGB(255, 50, 50) stroke.Thickness = 2

    local title = Instance.new("TextLabel", frame)
    title.Size = UDim2.new(1, 0, 0, 30)
    title.BackgroundTransparency = 1
    title.Text = "⚡ INTIMIDATOR"
    title.TextColor3 = Color3.fromRGB(255, 50, 50)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 14

    local scroll = Instance.new("ScrollingFrame", frame)
    scroll.Size = UDim2.new(1, 0, 1, -35)
    scroll.Position = UDim2.new(0, 0, 0, 35)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 3
    scroll.CanvasSize = UDim2.new(0, 0, 0, 350)

    local layout = Instance.new("UIListLayout", scroll)
    layout.Padding = UDim.new(0, 5)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local function createToggle(name, stateKey, specialCallback)
        local btn = Instance.new("TextButton", scroll)
        btn.Size = UDim2.new(0.9, 0, 0, 30)
        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        btn.Text = "OFF | " .. name
        btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        btn.Font = Enum.Font.GothamSemibold
        btn.TextSize = 12
        local c = Instance.new("UICorner", btn) c.CornerRadius = UDim.new(0, 5)
        
        btn.MouseButton1Click:Connect(function()
            states[stateKey] = not states[stateKey]
            if states[stateKey] then
                btn.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
                btn.Text = "ON | " .. name
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                btn.Text = "OFF | " .. name
                btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
            if specialCallback then specialCallback(states[stateKey]) end
        end)
    end

    createToggle("Shockwave Aura", "ShockwaveAura")
    createToggle("Meteor Dive", "MeteorDive")
    createToggle("Brawl Magnet", "BrawlMagnet")
    createToggle("Hitboxes", "Hitbox")
    createToggle("Mobile Fly", "Fly", toggleFly)
    createToggle("AimLock", "AimLock")
    createToggle("ESP", "ESP")
    
    createToggle("Noclip", "Noclip", function(state)
        if state then
            noclipConnection = RunService.Stepped:Connect(function()
                if localPlayer.Character then
                    for _, p in ipairs(localPlayer.Character:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                end
            end)
        else
            if noclipConnection then noclipConnection:Disconnect() end
        end
    end)
end

createUI()

