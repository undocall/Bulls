local function isEnemy(player)
    if player == localPlayer then return false end
    if localPlayer.Team and player.Team and localPlayer.Team == player.Team then return false end
    return true
end

local function playSound(soundId)
    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Parent = workspace
    pcall(function() sound:Play() end)
    Debris:AddItem(sound, 2)
end

local function cleanupPlayer(player)
    if espGuis[player] then espGuis[player]:Destroy(); espGuis[player] = nil end
    if trajectoryBeams[player] then
        trajectoryBeams[player].att0:Destroy()
        trajectoryBeams[player].att1:Destroy()
        trajectoryBeams[player].beam:Destroy()
        trajectoryBeams[player] = nil
    end
end

Players.PlayerRemoving:Connect(cleanupPlayer)

