local function togglePhantomLobby(state)
    phantomLobbyEnabled = state
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    if state then
        -- Create Safe Lobby 90,000 studs in the sky
        if not phantomPlatform then
            phantomPlatform = Instance.new("Part")
            phantomPlatform.Size = Vector3.new(100, 5, 100)
            phantomPlatform.Position = Vector3.new(0, 90000, 0)
            phantomPlatform.Anchored = true
            phantomPlatform.Material = Enum.Material.ForceField
            phantomPlatform.BrickColor = BrickColor.new("Really black")
            phantomPlatform.Transparency = 0.5
            phantomPlatform.Parent = workspace
        end
        char.HumanoidRootPart.CFrame = CFrame.new(0, 90005, 0)
    else
        -- Destroy Lobby and return to map
        if phantomPlatform then phantomPlatform:Destroy() phantomPlatform = nil end
        char.HumanoidRootPart.CFrame = CFrame.new(0, 100, 0)
        phantomAttackEnabled = false -- auto turn off attack when leaving lobby
    end
end

