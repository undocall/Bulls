-- ==============================================
-- 💣 ALL-IN-ONE MAX KILL AURA & MAGNET
-- ==============================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer

-- Master Settings
local auraEnabled = false
local autoEquipEnabled = true
local magnetEnabled = true
local teamCheck = true
local hitboxSize = Vector3.new(300, 300, 300)

-- Target Validator
local function isEnemy(player)
    if player == localPlayer or not player.Character then return false end
    local enemyHum = player.Character:FindFirstChild("Humanoid")
    if not enemyHum or enemyHum.Health <= 0 then return false end
    
    if teamCheck and localPlayer.Team and player.Team then
        return localPlayer.Team ~= player.Team
    end
    return true
end

-- RenderStepped Main Loop (Fires on every frame)
RunService.RenderStepped:Connect(function()
    if not auraEnabled then return end

    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    -- 1. Auto-Equip Tool
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool and autoEquipEnabled then
        local bpTool = localPlayer.Backpack:FindFirstChildOfClass("Tool")
        if bpTool then
            char.Humanoid:EquipTool(bpTool)
            tool = bpTool
        end
    end

    -- 2. Frame-Perfect Auto Swing
    if tool then
        pcall(function()
            tool:Activate()
        end)
    end

    -- 3. Hitbox Expansion & Magnet Teleportation
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                -- Resize & Style Hitbox
                root.Size = hitboxSize
                root.Transparency = 0.8
                root.BrickColor = BrickColor.new("Really red")
                root.Material = Enum.Material.Neon
                root.CanCollide = false
                
                -- Teleport Hitbox in front of character
                if magnetEnabled then
                    root.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0, 0, -2.5)
                end
            end
        end
    end
end)

-- ==============================================
-- 📱 UI CONTROLS
-- ==============================================
local uiLibrary = loadstring(game:HttpGet("https://raw.githubusercontent.com/AZYsGithub/Arceus-X-UI-Library/main/source.lua"))()
uiLibrary:SetTitle("ALL-IN-ONE AUTO-HIT")
uiLibrary:SetTheme("HighContrast")

uiLibrary:AddToggle("💣 ENABLE MAX KILL AURA", function(state)
    auraEnabled = state
end, false)

uiLibrary:AddToggle("🧲 Hitbox Magnet", function(state)
    magnetEnabled = state
end, true)

uiLibrary:AddToggle("⚔️ Auto-Equip Weapon", function(state)
    autoEquipEnabled = state
end, true)

uiLibrary:AddToggle("🛡️ Team Check", function(state)
    teamCheck = state
end, true)

uiLibrary:AddButton("Size: Medium (50)", function()
    hitboxSize = Vector3.new(50, 50, 50)
end)

uiLibrary:AddButton("Size: Large (150)", function()
    hitboxSize = Vector3.new(150, 150, 150)
end)

uiLibrary:AddButton("Size: MAX (500)", function()
    hitboxSize = Vector3.new(500, 500, 500)
end)

uiLibrary:AddButton("🧹 Fix Lag (Clear Dead Bodies)", function()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj.Humanoid.Health <= 0 then
            obj:Destroy()
        end
    end
end)
