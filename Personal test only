-- ═══════════ CUSTOM VALUE ROW HELPER ═══════════
-- Creates "Label  [−]  value  [+]" — single tap = single change
local function createValueRow(parent, name, initialVal, minVal, maxVal, step, onChange)
    local row = Instance.new("Frame")
    row.Name = name .. "_Row"
    row.Size = UDim2.new(1, 0, 0, 44)
    row.BackgroundColor3 = Color3.fromRGB(25, 22, 35)
    row.BorderSizePixel = 0
    row.Parent = parent
    
    local rc = Instance.new("UICorner")
    rc.CornerRadius = UDim.new(0, 8)
    rc.Parent = row
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 80, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.fromRGB(230, 230, 240)
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row
    
    local valueText = Instance.new("TextLabel")
    valueText.Name = "Value"
    valueText.Size = UDim2.new(0, 50, 1, 0)
    valueText.Position = UDim2.new(0.5, -25, 0, 0)
    valueText.BackgroundTransparency = 1
    valueText.Text = tostring(initialVal)
    valueText.TextColor3 = Color3.fromRGB(167, 93, 255)
    valueText.Font = Enum.Font.GothamBold
    valueText.TextSize = 16
    valueText.Parent = row
    
    local minusBtn = Instance.new("TextButton")
    minusBtn.Name = "Minus"
    minusBtn.Size = UDim2.new(0, 38, 0, 30)
    minusBtn.Position = UDim2.new(1, -90, 0.5, -15)
    minusBtn.BackgroundColor3 = Color3.fromRGB(40, 33, 58)
    minusBtn.Text = "−"
    minusBtn.TextColor3 = Color3.fromRGB(230, 230, 240)
    minusBtn.Font = Enum.Font.GothamBold
    minusBtn.TextSize = 18
    minusBtn.AutoButtonColor = false
    minusBtn.Parent = row
    
    local mc = Instance.new("UICorner")
    mc.CornerRadius = UDim.new(0, 6)
    mc.Parent = minusBtn
    
    local plusBtn = Instance.new("TextButton")
    plusBtn.Name = "Plus"
    plusBtn.Size = UDim2.new(0, 38, 0, 30)
    plusBtn.Position = UDim2.new(1, -48, 0.5, -15)
    plusBtn.BackgroundColor3 = Color3.fromRGB(40, 33, 58)
    plusBtn.Text = "+"
    plusBtn.TextColor3 = Color3.fromRGB(230, 230, 240)
    plusBtn.Font = Enum.Font.GothamBold
    plusBtn.TextSize = 18
    plusBtn.AutoButtonColor = false
    plusBtn.Parent = row
    
    local pc = Instance.new("UICorner")
    pc.CornerRadius = UDim.new(0, 6)
    pc.Parent = plusBtn
    
    local currentValue = initialVal
    
    local function doChange(delta)
        currentValue = math.clamp(currentValue + delta, minVal, maxVal)
        valueText.Text = tostring(currentValue)
        if onChange then onChange(currentValue) end
    end
    
    -- MouseButton1Click fires ONCE per tap. No repeat.
    plusBtn.MouseButton1Click:Connect(function()
        doChange(step)
    end)
    
    minusBtn.MouseButton1Click:Connect(function()
        doChange(-step)
    end)
    
    return {
        setValue = function(v)
            currentValue = math.clamp(v, minVal, maxVal)
            valueText.Text = tostring(currentValue)
        end,
        getValue = function() return currentValue end
    }
end

