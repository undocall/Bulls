-- ═══════════ HELPER: VALUE ROW ( [+] value [-] ) ═══════════
-- Single tap = single change. No repeat. No loop.

local function addValueRow(labelText, initialVal, minVal, maxVal, step, onChange)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 44)
    row.BackgroundColor3 = COL.card
    row.BorderSizePixel = 0
    row.Parent = content

    local rowCorner = Instance.new("UICorner")
    rowCorner.CornerRadius = UDim.new(0, 8)
    rowCorner.Parent = row

    local rowStroke = Instance.new("UIStroke")
    rowStroke.Color = COL.border
    rowStroke.Thickness = 1
    rowStroke.Transparency = 0.6
    rowStroke.Parent = row

    -- Label (left)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 80, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = COL.text
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    -- Value display (center)
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0, 60, 1, 0)
    valueLabel.Position = UDim2.new(0.5, -30, 0, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(initialVal)
    valueLabel.TextColor3 = COL.accentLight
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextSize = 16
    valueLabel.Parent = row

    -- Minus button (right side, left of plus)
    local minusBtn = Instance.new("TextButton")
    minusBtn.Size = UDim2.new(0, 40, 0, 32)
    minusBtn.Position = UDim2.new(1, -94, 0.5, -16)
    minusBtn.BackgroundColor3 = COL.btnBg
    minusBtn.Text = "−"
    minusBtn.TextColor3 = COL.text
    minusBtn.Font = Enum.Font.GothamBold
    minusBtn.TextSize = 18
    minusBtn.AutoButtonColor = false
    minusBtn.Parent = row

    local mCorner = Instance.new("UICorner")
    mCorner.CornerRadius = UDim.new(0, 6)
    mCorner.Parent = minusBtn

    -- Plus button (far right)
    local plusBtn = Instance.new("TextButton")
    plusBtn.Size = UDim2.new(0, 40, 0, 32)
    plusBtn.Position = UDim2.new(1, -50, 0.5, -16)
    plusBtn.BackgroundColor3 = COL.btnBg
    plusBtn.Text = "+"
    plusBtn.TextColor3 = COL.text
    plusBtn.Font = Enum.Font.GothamBold
    plusBtn.TextSize = 18
    plusBtn.AutoButtonColor = false
    plusBtn.Parent = row

    local pCorner = Instance.new("UICorner")
    pCorner.CornerRadius = UDim.new(0, 6)
    pCorner.Parent = plusBtn

    -- Current value
    local currentValue = initialVal

    -- SINGLE TAP HANDLER — fires once per tap, no repeat
    local function doChange(delta)
        currentValue = math.clamp(currentValue + delta, minVal, maxVal)
        valueLabel.Text = tostring(currentValue)
        playSound("rbxassetid://12221976")
        if onChange then onChange(currentValue) end
    end

    -- MouseButton1Click = fires ONCE per click/tap. no repeat.
    plusBtn.MouseButton1Click:Connect(function()
        doChange(step)
    end)

    minusBtn.MouseButton1Click:Connect(function()
        doChange(-step)
    end)

    -- Brief visual feedback on tap
    plusBtn.TouchTap:Connect(function()
        TweenService:Create(plusBtn, TweenInfo.new(0.1), {BackgroundColor3 = COL.accent}):Play()
        task.wait(0.1)
        TweenService:Create(plusBtn, TweenInfo.new(0.15), {BackgroundColor3 = COL.btnBg}):Play()
    end)

    minusBtn.TouchTap:Connect(function()
        TweenService:Create(minusBtn, TweenInfo.new(0.1), {BackgroundColor3 = COL.accent}):Play()
        task.wait(0.1)
        TweenService:Create(minusBtn, TweenInfo.new(0.15), {BackgroundColor3 = COL.btnBg}):Play()
    end)

    -- External setter (so other code can update the display)
    local function setValue(v)
        currentValue = math.clamp(v, minVal, maxVal)
        valueLabel.Text = tostring(currentValue)
    end

    return {setValue = setValue, getValue = function() return currentValue end}
end

