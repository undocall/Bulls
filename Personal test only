-- Improved team detection function
local function isEnemy(player)
    if player == localPlayer then return false end
    local teams = game:GetService("Teams"):GetTeams()
    if #teams > 1 then
        if localPlayer.Team == nil or player.Team == nil then return true end
        return localPlayer.Team ~= player.Team
    else
        return true
    end
end

-- Sound function with better error handling
local function playSound(soundId)
    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Parent = workspace
    local success, err = pcall(function() sound:Play() end)
    if not success then
        warn("Failed to play sound: " .. err)
        sound:Destroy()
        return
    end
    sound.Ended:Connect(function() sound:Destroy() end)
end

