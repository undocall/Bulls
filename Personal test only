-- ═══════════ INVISIBLE (STANDALONE GHOST) ═══════════
local invisibleEnabled = false
local invisibleParts = {}
local invisibleConnection = nil

local function setupInvisibleParts()
    invisibleParts = {}
    local char = lp.Character
    if not char then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d.Transparency == 0 then table.insert(invisibleParts, d) end
    end
end

local function startInvisible()
    if invisibleEnabled then return end
    invisibleEnabled = true
    if flyV3Active then stopFlyV3() end
    setupInvisibleParts()
    for _, part in ipairs(invisibleParts) do pcall(function() part.Transparency = 0.5 end) end
    if not invisibleConnection then
        invisibleConnection = RunService.Heartbeat:Connect(function()
            if not invisibleEnabled then return end
            local c = lp.Character
            if not c then return end
            local h = c:FindFirstChildOfClass("Humanoid")
            local r = c:FindFirstChild("HumanoidRootPart")
            if not h or not r then return end
            pcall(function()
                local origCF = r.CFrame
                local origOffset = h.CameraOffset
                local downCF = origCF * CFrame.new(0, -200000, 0)
                r.CFrame = downCF
                h.CameraOffset = downCF:ToObjectSpace(CFrame.new(origCF.Position)).Position
                RunService.RenderStepped:Wait()
                r.CFrame = origCF
                h.CameraOffset = origOffset
            end)
        end)
    end
end

local function stopInvisible()
    invisibleEnabled = false
    for _, part in ipairs(invisibleParts) do pcall(function() part.Transparency = 0 end) end
    invisibleParts = {}
    if invisibleConnection then invisibleConnection:Disconnect() invisibleConnection = nil end
    local char = lp.Character
    if char then
        local h = char:FindFirstChildOfClass("Humanoid")
        if h then pcall(function() h.CameraOffset = Vector3.zero end) end
    end
end

-- ═══════════ FLY V3 ═══════════
local flyV3Active = false
local flyV3Speed = 1
local flyV3UpHeld = false
local flyV3DownHeld = false

local function startFlyV3()
    if flyV3Active then return end
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if invisibleEnabled then stopInvisible() end
    flyV3Active = true
    disableAllHumanoidStates(hum)
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Swimming) end)
    pcall(function()
        if char:FindFirstChild("Animate") then char.Animate.Disabled = true end
        for _, v in ipairs(hum:GetPlayingAnimationTracks()) do v:AdjustSpeed(0) end
    end)

    for i = 1, flyV3Speed do
        task.spawn(function()
            local hb = RunService.Heartbeat
            while flyV3Active do
                hb:Wait()
                local c = lp.Character
                if not c then break end
                local h = c:FindFirstChildOfClass("Humanoid")
                if not h or not h.Parent then break end
                if h.MoveDirection.Magnitude > 0 then pcall(function() c:TranslateBy(h.MoveDirection) end) end
            end
        end)
    end

    task.spawn(function()
        local isR6 = (hum.RigType == Enum.HumanoidRigType.R6)
        local torso = isR6 and char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        if not torso then flyV3Active = false return end

        local bg = Instance.new("BodyGyro", torso)
        bg.P = 9e4; bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9); bg.CFrame = torso.CFrame
        local bv = Instance.new("BodyVelocity", torso)
        bv.Velocity = Vector3.new(0, 0.1, 0); bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        hum.PlatformStand = true

        while flyV3Active do
            RunService.RenderStepped:Wait()
            local c = lp.Character
            if not c then break end
            local h = c:FindFirstChildOfClass("Humanoid")
            local hrp = c:FindFirstChild("HumanoidRootPart")
            if not h or not hrp or h.Health <= 0 then break end
            if flyV3UpHeld then pcall(function() hrp.CFrame = hrp.CFrame * CFrame.new(0, 1, 0) end)
            elseif flyV3DownHeld then pcall(function() hrp.CFrame = hrp.CFrame * CFrame.new(0, -1, 0) end) end
            bv.Velocity = Vector3.zero
            bg.CFrame = workspace.CurrentCamera.CFrame
        end
        bg:Destroy() bv:Destroy()
        pcall(function() hum.PlatformStand = false; if char:FindFirstChild("Animate") then char.Animate.Disabled = false end end)
    end)
end

local function stopFlyV3()
    flyV3Active = false
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        enableAllHumanoidStates(hum)
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics); hum.PlatformStand = false end)
    end
    pcall(function() if char:FindFirstChild("Animate") then char.Animate.Disabled = false end end)
end

-- ═══════════ TELEPORT & MOUNT STRIP ═══════════
local function stripMount(character)
    if not character then return end
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") then
            if (d.Part0 and d.Part0.Name:lower():find("seat")) or (d.Part1 and d.Part1.Name:lower():find("seat")) then pcall(function() d:Destroy() end) end
        end
    end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum and hum.Sit then hum.Sit = false; hum.SeatPart = nil; hum.Jump = true end
end

local function teleportToArena(force)
    local char = lp.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    if not force and hrp.Position.Z < LOBBY_MAX_Z then return false end
    stripMount(char)
    hrp.CFrame = CFrame.new(ARENA_TELEPORT)
    return true
end

