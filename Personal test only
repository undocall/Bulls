local function stripMount(character)
    if not character then return end
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") then
            local p0, p1 = d.Part0, d.Part1
            if p0 and p1 then
                local n0, n1 = p0.Name:lower(), p1.Name:lower()
                if n0:find("seat") or n1:find("seat") or n0:find("bull") or n1:find("bull") then pcall(function() d:Destroy() end) end
            end
        end
    end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum and hum.Sit then hum.Sit = false; hum.SeatPart = nil; hum.Jump = true end
end

local function teleportToArena(force)
    local char = lp.Character
    if not char then return false, "no character" end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false, "no root" end
    if hum.Health <= 0 then return false, "dead" end
    pcall(function() hum.Sit = false; hum.SeatPart = nil; hum.PlatformStand = false end)
    stripMount(char)
    task.wait(0.1)
    pcall(function()
        hrp.Anchored = true; hrp.CFrame = CFrame.new(ARENA_TELEPORT)
        hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    task.wait(0.15)
    pcall(function() hrp.Anchored = false; hrp.CFrame = CFrame.new(ARENA_TELEPORT) end)
    task.spawn(function() for i = 1, 20 do task.wait(0.05); stripMount(char) end end)
    return true, "ok"
end

