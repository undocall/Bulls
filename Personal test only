local function smartFind(input)
    if not input or #input < 1 then return nil end
    input = input:lower():gsub("@", "")
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == input or p.DisplayName:lower() == input then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1, #input) == input then return p end
        if p.DisplayName:lower():sub(1, #input) == input then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(input, 1, true) then return p end
        if p.DisplayName:lower():find(input, 1, true) then return p end
    end
    return nil
end

