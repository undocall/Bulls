-- ═══════════ HITBOX SYSTEM (backend — unchanged) ═══════════

local function applyHitbox(character)
    if not character then return end
    local player = Players:GetPlayerFromCharacter(character)
    if player and player == localPlayer then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso")
    
    if rootPart then
        if not rootPart:FindFirstChild("OriginalSize") then
            local originalSize = Instance.new("Vector3Value")
            originalSize.Name = "OriginalSize"
            originalSize.Value = rootPart.Size
            originalSize.Parent = rootPart
        end
        rootPart.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
        rootPart.Transparency = 0.9
        rootPart.CanCollide = false
        
        local lowerTorso = character:FindFirstChild("LowerTorso")
        if lowerTorso then
            if not lowerTorso:FindFirstChild("OriginalSize") then
                local os = Instance.new("Vector3Value")
                os.Name = "OriginalSize"
                os.Value = lowerTorso.Size
                os.Parent = lowerTorso
            end
            lowerTorso.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
            lowerTorso.Transparency = 0.9
            lowerTorso.CanCollide = false
        end
    end
    
    local head = character:FindFirstChild("Head")
    if head then
        if not head:FindFirstChild("OriginalSize") then
            local os = Instance.new("Vector3Value")
            os.Name = "OriginalSize"
            os.Value = head.Size
            os.Parent = head
        end
        head.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
        head.Transparency = 0.9
        head.CanCollide = false
        head.Massless = true
    end
end

local function resetHitbox(character)
    if not character then return end
    local player = Players:GetPlayerFromCharacter(character)
    if player and player == localPlayer then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso")
    if rootPart and rootPart:FindFirstChild("OriginalSize") then
        rootPart.Size = rootPart.OriginalSize.Value
        rootPart.Transparency = 1
        rootPart.CanCollide = true
    end
    
    local head = character:FindFirstChild("Head")
    if head and head:FindFirstChild("OriginalSize") then
        head.Size = head.OriginalSize.Value
        head.Transparency = 1
        head.CanCollide = true
        head.Massless = false
    end
    
    local lowerTorso = character:FindFirstChild("LowerTorso")
    if lowerTorso and lowerTorso:FindFirstChild("OriginalSize") then
        lowerTorso.Size = lowerTorso.OriginalSize.Value
        lowerTorso.Transparency = 1
        lowerTorso.CanCollide = true
    end
end

function applyHitboxesToAll()
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) and player.Character then
            applyHitbox(player.Character)
        end
    end
end

function resetHitboxesOnAll()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then resetHitbox(player.Character) end
    end
end

-- ═══════════ ESP SYSTEM (backend — unchanged) ═══════════

function createESP(player)
    if espGuis[player] then espGuis[player]:Destroy() espGuis[player] = nil end
    if not player or not player.Character or player == localPlayer then return end
    
    if isEnemy(player) then
        local head = player.Character:FindFirstChild("Head")
        local rootPart = player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("UpperTorso")
        local targetPart = head or rootPart
        if not targetPart then return end
        
        local espGui = Instance.new("BillboardGui")
        espGui.Name = "ESP"
        espGui.Adornee = targetPart
        espGui.Size = UDim2.new(0, 100, 0, 50)
        espGui.StudsOffset = Vector3.new(0, 2, 0)
        espGui.AlwaysOnTop = true
        
        local espLabel = Instance.new("TextLabel", espGui)
        espLabel.Size = UDim2.new(1, 0, 1, 0)
        espLabel.BackgroundTransparency = 1
        espLabel.TextColor3 = Color3.new(1, 0, 0)
        espLabel.TextStrokeTransparency = 0
        espLabel.Text = player.Name
        espLabel.TextScaled = true
        espLabel.Font = Enum.Font.SourceSansBold
        
        espGuis[player] = espGui
        espGui.Parent = targetPart
    end
end

function toggleESP(enabled)
    espEnabled = enabled
    if enabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if isEnemy(player) then createESP(player) end
        end
    else
        for _, gui in pairs(espGuis) do if gui then gui:Destroy() end end
        espGuis = {}
    end
end

-- PLAYER TRACKING
local function trackPlayer(player)
    if not player then return end
    if isEnemy(player) then
        player.CharacterAdded:Connect(function(character)
            task.wait(1)
            local humanoid = character:WaitForChild("Humanoid")
            local function updateState()
                if hitboxEnabled then
                    if humanoid.Health > 0 then applyHitbox(character) else resetHitbox(character) end
                end
            end
            updateState()
            humanoid.HealthChanged:Connect(updateState)
            if espEnabled then createESP(player) end
        end)
        
        if player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                if hitboxEnabled then
                    if humanoid.Health > 0 then applyHitbox(player.Character) else resetHitbox(player.Character) end
                end
                if espEnabled then createESP(player) end
            end
        end
    end
end

for _, player in ipairs(Players:GetPlayers()) do trackPlayer(player) end
Players.PlayerAdded:Connect(trackPlayer)
Players.PlayerRemoving:Connect(function(player)
    if espGuis[player] then espGuis[player]:Destroy() espGuis[player] = nil end
end)

-- ═══════════ PHYSICS LOOP ═══════════

RunService.Stepped:Connect(function()
    local char = localPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if hum and getgenv().superPowerEnabled then
        hum.WalkSpeed = 120
        hum.JumpPower = 150
        hum.UseJumpPower = true
    end

    if getgenv().noclipEnabled then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end

    -- SMART RECOVERY
    if hum and hrp and getgenv().instantRecoveryEnabled then
        local state = hum:GetState()
        local isKnocked = (hum.PlatformStand or hum.Sit or 
            state == Enum.HumanoidStateType.FallingDown or 
            state == Enum.HumanoidStateType.Ragdoll or 
            state == Enum.HumanoidStateType.GettingUp)
        
        if isKnocked then
            local rayOrigin = hrp.Position
            local rayDirection = Vector3.new(0, -4.5, 0)
            local raycastParams = RaycastParams.new()
            raycastParams.FilterDescendantsInstances = {char}
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
            local floorHit = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
            
            if floorHit or hum.FloorMaterial ~= Enum.Material.Air then
                hrp.AssemblyAngularVelocity = Vector3.zero
                if not getgenv().isRecovering then
                    getgenv().isRecovering = true
                    task.spawn(function()
                        local delayTime = getgenv().recoveryDelay or 0.6
                        if delayTime > 0 then task.wait(delayTime) end
                        if char and hum and hrp and hum.Health > 0 then
                            hum.PlatformStand = false
                            hum.Sit = false
                            hum:ChangeState(Enum.HumanoidStateType.Running)
                            hrp.AssemblyAngularVelocity = Vector3.zero
                            local rx, ry, rz = hrp.CFrame:ToOrientation()
                            hrp.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, ry, 0)
                        end
                        task.wait(0.2)
                        getgenv().isRecovering = false
                    end)
                end
            end
        else
            getgenv().isRecovering = false
        end
    end
end)

