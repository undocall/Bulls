RunService.Stepped:Connect(function()
    local char = localPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if hum and getgenv().superPowerEnabled then
        hum.WalkSpeed = 120
        hum.JumpPower = 150
        hum.UseJumpPower = true
    end

    if getgenv().noclipEnabled then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end

    -- SMART RECOVERY
    if hum and hrp and getgenv().instantRecoveryEnabled then
        local state = hum:GetState()
        local isKnocked = (hum.PlatformStand or hum.Sit or 
            state == Enum.HumanoidStateType.FallingDown or 
            state == Enum.HumanoidStateType.Ragdoll or 
            state == Enum.HumanoidStateType.GettingUp)
        
        if isKnocked then
            local rayOrigin = hrp.Position
            local rayDirection = Vector3.new(0, -4.5, 0)
            local raycastParams = RaycastParams.new()
            raycastParams.FilterDescendantsInstances = {char}
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
            local floorHit = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
            
            if floorHit or hum.FloorMaterial ~= Enum.Material.Air then
                hrp.AssemblyAngularVelocity = Vector3.zero
                if not getgenv().isRecovering then
                    getgenv().isRecovering = true
                    task.spawn(function()
                        local delayTime = getgenv().recoveryDelay or 0.6
                        if delayTime > 0 then task.wait(delayTime) end
                        if char and hum and hrp and hum.Health > 0 then
                            hum.PlatformStand = false
                            hum.Sit = false
                            hum:ChangeState(Enum.HumanoidStateType.Running)
                            hrp.AssemblyAngularVelocity = Vector3.zero
                            local rx, ry, rz = hrp.CFrame:ToOrientation()
                            hrp.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, ry, 0)
                        end
                        task.wait(0.2)
                        getgenv().isRecovering = false
                    end)
                end
            end
        else
            getgenv().isRecovering = false
        end
    end
end)

