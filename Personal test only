local noFallEnabled = false
local noFallConnection

local function executeACR(char, hum, hrp)
    if not (char and hum and hrp) then return end
    pcall(function()
        hrp.Anchored = true
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hum.PlatformStand = false
        hum.Sit = false
        
        local currentPos = hrp.Position
        local lookVector = hrp.CFrame.LookVector
        local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z).Unit
        if flatLook.Magnitude < 0.1 then flatLook = Vector3.new(0, 0, -1) end
        
        local newPos = currentPos + Vector3.new(0, 2.5, 0)
        hrp.CFrame = CFrame.new(newPos, newPos + flatLook)
        hum:ChangeState(Enum.HumanoidStateType.Freefall)
        
        task.wait(0.05)
        hrp.Anchored = false
        hum.Jump = true
    end)
end

local function applyHumanoidStates(hum, enabled)
    if hum then
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, not enabled)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, not enabled)
    end
end

local function toggleAntiFling(enabled)
    noFallEnabled = enabled
    pcall(function() playSound("rbxassetid://12221976") end)
    
    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if enabled then
        flingBtn.Text = "A-Fling: ON"
        flingBtn.TextColor3 = Color3.fromRGB(75, 255, 75)
        flingStroke.Color = Color3.fromRGB(75, 255, 75)
        executeACR(char, hum, hrp)
        applyHumanoidStates(hum, true)
        
        if not noFallConnection then
            noFallConnection = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local character = localPlayer.Character
                    if not character then return end
                    local root = character:FindFirstChild("HumanoidRootPart")
                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    if root and humanoid then
                        local linVel = root.AssemblyLinearVelocity
                        local angVel = root.AssemblyAngularVelocity
                        local horizSpeed = Vector3.new(linVel.X, 0, linVel.Z).Magnitude
                        
                        if horizSpeed > 150 or angVel.Magnitude > 75 then
                            executeACR(character, humanoid, root)
                        end
                        if humanoid.PlatformStand then
                            humanoid.PlatformStand = false
                            humanoid.Jump = true
                        end
                    end
                end)
            end)
        end
    else
        flingBtn.Text = "A-Fling: OFF"
        flingBtn.TextColor3 = Color3.fromRGB(255, 75, 75)
        flingStroke.Color = Color3.fromRGB(255, 75, 75)
        if noFallConnection then
            noFallConnection:Disconnect()
            noFallConnection = nil
        end
        applyHumanoidStates(hum, false)
        executeACR(char, hum, hrp)
    end
end

flingBtn.MouseButton1Click:Connect(function()
    toggleAntiFling(not noFallEnabled)
end)

localPlayer.CharacterAdded:Connect(function(char)
    if noFallEnabled then
        task.wait(0.5)
        local hum = char:WaitForChild("Humanoid")
        applyHumanoidStates(hum, true)
    end
end)

------------------------------------------------------------------
-- GLOBAL TELEPORT KILL-AURA & FLING (OUTLOBBY REACH)
------------------------------------------------------------------
local reachRange = 15000 -- Expanded to basically the entire map
local rangeSquared = reachRange * reachRange

uiLibrary:AddToggle("Global Autohit / Fling (Cross-map)", function(enabled)
    getgenv().globalAuraEnabled = enabled
    playSound("rbxassetid://12221976")
    
    if enabled then
        if not getgenv().globalAuraConnection then
            getgenv().globalAuraConnection = RunService.Heartbeat:Connect(function()
                if not getgenv().globalAuraEnabled then return end
                
                local char = localPlayer.Character
                if not char then return end
                local myRoot = char:FindFirstChild("HumanoidRootPart")
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                
                if not (myRoot and humanoid and humanoid.Health > 0) then return end
                
                -- Save original position to return to after the strike
                local originalCFrame = myRoot.CFrame
                
                local tool = char:FindFirstChildOfClass("Tool")
                local handle = tool and (tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart"))
                
                for _, player in ipairs(Players:GetPlayers()) do
                    if isEnemy(player) and player.Character then
                        local eChar = player.Character
                        local eHum = eChar:FindFirstChildOfClass("Humanoid")
                        local eRoot = eChar:FindFirstChild("HumanoidRootPart") or eChar:FindFirstChild("UpperTorso")
                        
                        if eRoot and eHum and eHum.Health > 0 then
                            local offset = originalCFrame.Position - eRoot.Position
                            local distSq = offset.X*offset.X + offset.Y*offset.Y + offset.Z*offset.Z
                            
                            -- If within map range, execute rapid teleport strike
                            if distSq <= rangeSquared then
                                -- 1. Teleport to enemy
                                myRoot.CFrame = eRoot.CFrame * CFrame.new(0, 0, 1)
                                
                                -- 2. Apply Fling Physics
                                myRoot.AssemblyLinearVelocity = Vector3.zero
                                myRoot.AssemblyAngularVelocity = Vector3.new(100000, 100000, 100000)
                                
                                -- 3. Attempt standard tool hit if equipped
                                if tool and handle then
                                    tool:Activate()
                                    if firetouchinterest then
                                        firetouchinterest(handle, eRoot, 0)
                                        firetouchinterest(handle, eRoot, 1)
                                    end
                                end
                                
                                -- Wait one physics frame to let the server register the collision/hit
                                task.wait(0.01)
                            end
                        end
                    end
                end
                
                -- Neutralize physics and snap back to the lobby/safe zone
                myRoot.AssemblyAngularVelocity = Vector3.zero
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.CFrame = originalCFrame
                
                -- Add a slight delay to prevent instant network disconnects
                task.wait(0.1)
            end)
        end
    else
        if getgenv().globalAuraConnection then
            getgenv().globalAuraConnection:Disconnect()
            getgenv().globalAuraConnection = nil
        end
    end
end, false)

