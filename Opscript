local LEARNED = {}
local MIN_DELAY = 3.0
local MAX_DELAY = 7.5
local ACCURACY  = 0.97

local currentToken  = nil
local currentTarget = nil
local currentRef    = nil
local submitted     = {}
local gameEvent     = nil
local badge         = nil

local function findEvent()
    for _, v in ipairs(RS:GetDescendants()) do
        if v:IsA("RemoteEvent") and v.Name == "Event" then
            gameEvent = v
            return
        end
    end
end
findEvent()
RS.DescendantAdded:Connect(function(v)
    if v:IsA("RemoteEvent") and v.Name == "Event" and not gameEvent then
        gameEvent = v
    end
end)

local function getRatio(targetId, refId)
    -- learned = most accurate, seen this exact pair before
    local key = targetId.."_vs_"..refId
    if LEARNED[key] then return LEARNED[key], "LEARNED" end

    local tSize = SIZES[targetId]
    local rSize = SIZES[refId]

    -- exact match
    if tSize and rSize then return tSize / rSize, "DATABASE" end

    -- partial match on substrings
    if not tSize then
        for k, v in pairs(SIZES) do
            if targetId:find(k) or k:find(targetId) then
                tSize = v break
            end
        end
    end
    if not rSize then
        for k, v in pairs(SIZES) do
            if refId:find(k) or k:find(refId) then
                rSize = v break
            end
        end
    end

    if tSize and rSize then return tSize / rSize, "PARTIAL" end

    return nil, "FALLBACK"
end

local function doWin(token, targetId, refId)
    if submitted[token] then return end

    local ratio, source = getRatio(targetId, refId)
    if not ratio then ratio = 1.0 end

    local jitter = 1 + (math.random() * 0.05 - 0.025)
    local final  = ratio * ACCURACY * jitter
    local delay  = MIN_DELAY + math.random() * (MAX_DELAY - MIN_DELAY)
    local steps  = math.random(4, 8)
    local startR = final * (0.4 + math.random() * 0.3)

    if badge then
        badge.Text = source
        badge.BackgroundColor3 =
            source == "LEARNED"   and Color3.fromRGB(0, 200, 80)  or
            source == "DATABASE"  and Color3.fromRGB(0, 120, 255) or
            source == "PARTIAL"   and Color3.fromRGB(255, 160, 0) or
                                       Color3.fromRGB(200, 50, 50)
    end

    -- simulate natural drag from small to correct
    for i = 1, steps do
        task.wait(delay / (steps + 2))
        if submitted[token] then return end
        local t = i / steps
        local r = startR + (final - startR) * t
        local w = 1 + (math.random() * 0.03 - 0.015)
        gameEvent:FireServer("preview", { token = token, ratio = r * w })
    end

    task.wait(0.2 + math.random() * 0.5)
    if submitted[token] then return end
    submitted[token] = true

    gameEvent:FireServer("submit", { token = token, ratio = final })

    if badge then
        badge.Text = "DONE "..source
    end
end

local function hookEvent(remote)
    remote.OnClientEvent:Connect(function(eventType, data)
        if not data then return end

        if eventType == "round" then
            currentToken  = data.token
            currentTarget = data.target and data.target.id
            currentRef    = data.reference and data.reference.id
            submitted[currentToken] = false

            if badge then
                badge.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
                badge.Text = "..."
            end

            local tId = currentTarget
            local rId = currentRef
            local tok = currentToken
            task.spawn(function() doWin(tok, tId, rId) end)
        end

        if eventType == "reveal" then
            -- learn exact ratio + fill in missing sizes
            if currentTarget and currentRef and data.ratio then
                LEARNED[currentTarget.."_vs_"..currentRef] = data.ratio
                if data.height and not SIZES[currentTarget] then
                    SIZES[currentTarget] = data.height
                end
                if data.refHeight and not SIZES[currentRef] then
                    SIZES[currentRef] = data.refHeight
                end
            end
        end
    end)
end

local function init()
    local tries = 0
    while not gameEvent and tries < 30 do
        task.wait(0.5)
        findEvent()
        tries += 1
    end
    if gameEvent then hookEvent(gameEvent) end
end
task.spawn(init)

