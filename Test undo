-- Make ONLY the floating invisibility button draggable (mouse + touch).
-- A short tap still toggles invisibility; a drag only moves the button.
local draggingInv = false
local dragInputInv = nil
local dragStartInv = nil
local startPosInv = nil
local movedInv = false
local dragThresholdInv = 6

invisBtn.Active = true
invisBtn.Selectable = false

invisBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        draggingInv = true
        dragInputInv = input
        dragStartInv = input.Position
        startPosInv = invisBtn.Position
        movedInv = false

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                draggingInv = false
                dragInputInv = nil
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not draggingInv then return end

    local isMouseMove = input.UserInputType == Enum.UserInputType.MouseMovement
        and dragInputInv
        and dragInputInv.UserInputType == Enum.UserInputType.MouseButton1

    local isTouchMove = input == dragInputInv
        or (input.UserInputType == Enum.UserInputType.Touch
            and dragInputInv
            and dragInputInv.UserInputType == Enum.UserInputType.Touch)

    if isMouseMove or isTouchMove then
        local delta = input.Position - dragStartInv

        if delta.Magnitude >= dragThresholdInv then
            movedInv = true
        end

        if movedInv then
            local camera = workspace.CurrentCamera
            local viewport = camera and camera.ViewportSize
            local buttonSize = invisBtn.AbsoluteSize

            local newX = startPosInv.X.Offset + delta.X
            local newY = startPosInv.Y.Offset + delta.Y

            -- Keep the button fully inside the visible screen.
            if viewport then
                newX = math.clamp(newX, 0, math.max(0, viewport.X - buttonSize.X))
                newY = math.clamp(newY, 0, math.max(0, viewport.Y - buttonSize.Y))
            end

            invisBtn.Position = UDim2.new(
                startPosInv.X.Scale, newX,
                startPosInv.Y.Scale, newY
            )
        end
    end
end)

