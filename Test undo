local function makeBtn(text)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 34)
    b.BackgroundColor3 = COL_CARD
    b.BackgroundTransparency = 0.2
    b.Text = "▶ " .. text
    b.TextColor3 = COL_TEXT
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.AutoButtonColor = false
    b.Parent = content
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    Instance.new("UIStroke", b).Color = Color3.fromRGB(50, 30, 70)
    return b
end

local function toggleVisual(isOn, txt, swBg, knob, stroke, btnLabel)
    if isOn then
        TweenService:Create(swBg, TweenInfo.new(0.15), {BackgroundColor3 = COL_ACCENT}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(200, 100, 255)}):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {Position = UDim2.new(0, 16, 0.5, -6), BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        txt.Text = btnLabel .. ": ON"
    else
        TweenService:Create(swBg, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(40, 30, 50)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(80, 50, 120)}):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {Position = UDim2.new(0, 2, 0.5, -6), BackgroundColor3 = Color3.fromRGB(180, 180, 180)}):Play()
        txt.Text = btnLabel .. ": OFF"
    end
end

