local function addPage(name)
    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, -10, 1, -10); page.Position = UDim2.new(0, 5, 0, 5)
    page.BackgroundTransparency = 1; page.BorderSizePixel = 0; page.ScrollBarThickness = 2; page.ScrollBarImageColor3 = COL.accent
    page.CanvasSize = UDim2.new(0, 0, 0, 0); page.AutomaticCanvasSize = Enum.AutomaticSize.Y; page.Visible = false; page.Parent = contentArea
    local pl = Instance.new("UIListLayout"); pl.Padding = UDim.new(0, 6); pl.Parent = page
    local pp = Instance.new("UIPadding"); pp.PaddingTop = UDim.new(0, 5); pp.PaddingBottom = UDim.new(0, 10); pp.Parent = page
    pages[name] = page

    local sb = Instance.new("TextButton")
    sb.Size = UDim2.new(1, 0, 0, 36); sb.BackgroundColor3 = COL.glassAccent; sb.BackgroundTransparency = 0.5
    sb.Text = name; sb.TextColor3 = COL.textDim; sb.Font = Enum.Font.GothamBold; sb.TextSize = 13; sb.AutoButtonColor = false; sb.Parent = sidebar
    
    local sbc = Instance.new("UICorner"); sbc.CornerRadius = UDim.new(0, 6); sbc.Parent = sb
    local sbs = Instance.new("UIStroke"); sbs.Color = COL.accent; sbs.Thickness = 1; sbs.Transparency = 1; sbs.Parent = sb
    sideBtns[name] = {btn = sb, stroke = sbs}

    sb.MouseEnter:Connect(function() TweenService:Create(sb, TweenInfo.new(0.2), {BackgroundTransparency = 0.2}):Play() end)
    sb.MouseLeave:Connect(function() 
        if not sb:GetAttribute("Active") then
            TweenService:Create(sb, TweenInfo.new(0.2), {BackgroundTransparency = 0.5}):Play() 
        end
    end)

    sb.MouseButton1Click:Connect(function()
        for pn, pg in pairs(pages) do pg.Visible = (pn == name) end
        for bn, bd in pairs(sideBtns) do
            if bn == name then
                bd.btn.BackgroundColor3 = COL.accent; bd.btn.BackgroundTransparency = 0.1; bd.btn.TextColor3 = COL.text; bd.btn.Font = Enum.Font.GothamBlack
                bd.stroke.Transparency = 0
                bd.btn:SetAttribute("Active", true)
            else
                bd.btn.BackgroundColor3 = COL.glassAccent; bd.btn.BackgroundTransparency = 0.5; bd.btn.TextColor3 = COL.textDim; bd.btn.Font = Enum.Font.GothamBold
                bd.stroke.Transparency = 1
                bd.btn:SetAttribute("Active", false)
            end
        end
    end)
    return page
end

local function addToggleRow(page, name, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -10, 0, 40); row.BackgroundColor3 = COL.glassAccent; row.BackgroundTransparency = 0.3; row.BorderSizePixel = 0; row.Parent = page
    row.Name = name
    table.insert(searchableElements, row)
    
    local rowStroke = Instance.new("UIStroke"); rowStroke.Color = COL.accent; rowStroke.Thickness = 1; rowStroke.Transparency = 0.8; rowStroke.Parent = row

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -60, 1, 0); label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1; label.Text = name; label.TextColor3 = COL.text; label.Font = Enum.Font.GothamBold; label.TextSize = 13; label.TextXAlignment = Enum.TextXAlignment.Left; label.Parent = row
    
    local switchBg = Instance.new("Frame")
    switchBg.Size = UDim2.new(0, 38, 0, 20); switchBg.Position = UDim2.new(1, -50, 0.5, -10); switchBg.BackgroundColor3 = COL.bg; switchBg.BorderSizePixel = 0; switchBg.Parent = row
    local sc = Instance.new("UICorner"); sc.CornerRadius = UDim.new(1, 0); sc.Parent = switchBg
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 14, 0, 14); knob.Position = UDim2.new(0, 3, 0.5, -7); knob.BackgroundColor3 = COL.textDim; knob.BorderSizePixel = 0; knob.Parent = switchBg
    local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(1, 0); kc.Parent = knob
    
    local isOn = false
    local function updateVisual()
        if isOn then
            TweenService:Create(switchBg, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundColor3 = COL.accent}):Play()
            TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Position = UDim2.new(0, 21, 0.5, -7), BackgroundColor3 = COL.text}):Play()
            TweenService:Create(rowStroke, TweenInfo.new(0.2), {Transparency = 0.2}):Play()
        else
            TweenService:Create(switchBg, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundColor3 = COL.bg}):Play()
            TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = COL.textDim}):Play()
            TweenService:Create(rowStroke, TweenInfo.new(0.2), {Transparency = 0.8}):Play()
        end
    end
    
    local tBtn = Instance.new("TextButton"); tBtn.Size = UDim2.new(1, 0, 1, 0); tBtn.BackgroundTransparency = 1; tBtn.Text = ""; tBtn.Parent = row
    
    tBtn.MouseEnter:Connect(function() TweenService:Create(row, TweenInfo.new(0.1), {BackgroundTransparency = 0.1}):Play() end)
    tBtn.MouseLeave:Connect(function() TweenService:Create(row, TweenInfo.new(0.1), {BackgroundTransparency = 0.3}):Play() end)
    
    tBtn.MouseButton1Click:Connect(function()
        isOn = not isOn; updateVisual(); playSound("rbxassetid://12221976")
        if callback then callback(isOn) end
    end)
    return {set = function(v) isOn = v updateVisual() if callback then callback(v) end end}
end

local function addValueRow(page, name, initialVal, minVal, maxVal, step, onChange)
    local row = Instance.new("Frame")
