-- ═══════════ SMART ANTI-FLING — 2 TO 5 LIMIT (SMOOTH) ═══════════
-- Only zeros velocity if the player is ACTUALLY flying fast (>80)
-- Will not interrupt walking or jumping.
task.spawn(function()
    local fallCount = 0
    local lastFallTime = 0
    local permanentImmune = false
    local randomTarget = math.random(2, 5)
    local lastRecover = 0

    while true do
        task.wait(0.1) -- Slightly slower loop = less physics fighting = no lag
        
        if not getgenv().smartAntiFlingEnabled then
            fallCount = 0
            permanentImmune = false
            randomTarget = math.random(2, 5)
            continue
        end

        local char = localPlayer.Character
        if not char then continue end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not (hrp and hum) or hum.Health <= 0 then continue end

        local state = hum:GetState()
        local isKnocked = hum.PlatformStand or hum.Sit
            or state == Enum.HumanoidStateType.FallingDown
            or state == Enum.HumanoidStateType.Ragdoll
            or state == Enum.HumanoidStateType.GettingUp
            or state == Enum.HumanoidStateType.PlatformStanding

        local now = tick()
        
        -- Count knockdowns
        if isKnocked and (now - lastFallTime) > 2.0 then
            lastFallTime = now
            fallCount = fallCount + 1
            if fallCount >= randomTarget then
                permanentImmune = true
            end
        end

        -- Recovery / Immunity Logic
        if (permanentImmune or isKnocked) and (now - lastRecover) > 0.2 then
            lastRecover = now
            pcall(function()
                local v = hrp.AssemblyLinearVelocity
                local speed = math.sqrt(v.X * v.X + v.Z * v.Z)
                
                -- 🟢 ONLY STOP THEM IF THEY ARE FLYING (Fling Speed = 80+)
                -- Normal walking is 16. Jumping is ~50. This lets you jump freely.
                if speed > 80 then
                    hrp.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
                end
                
                -- Only clear spin if it's extreme
                if hrp.AssemblyAngularVelocity.Magnitude > 20 then
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
                
                -- Only force upright if they are on the ground (not mid-jump)
                if isKnocked and hum.FloorMaterial ~= Enum.Material.Air then
                    if hum.PlatformStand then hum.PlatformStand = false end
                    if hum.Sit then hum.Sit = false end
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end
            end)
        end
    end
end)

