                            end
                        end
                    end
                end

                myRoot.AssemblyAngularVelocity = Vector3.zero
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.CFrame = originalCFrame
                task.wait(0.1)
            end)
        end
    else
        if getgenv().globalAuraConnection then
            getgenv().globalAuraConnection:Disconnect()
            getgenv().globalAuraConnection = nil
        end
