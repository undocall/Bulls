-- ═══════════ SMART ANTI-FLING — INSTANT ARM, 80% GRACE ═══════════
-- Detects real fling instantly (velocity >100 OR knock state), no counter needed.
-- 80% dice roll on grace. Jump safety only delays velocity clearing, never arming.
task.spawn(function()
    local graceUntil    = 0
    local cooldownUntil = 0
    local lastRecover   = 0
    local lastArm       = 0

    local GRACE_DURATION = 20.0
    local COOLDOWN_MIN   = 8.0
    local COOLDOWN_MAX   = 15.0
    local SKIP_CHANCE    = 0.20          -- 80% grace
    local FLING_HORIZ    = 100           -- real fling speed (jump = ~50-70)
    local FLING_ANGULAR  = 60            -- real fling spin
    local RECOVER_GAP    = 0.8
    local ARM_GAP        = 1.2           -- min 1.2s between arm attempts
    local JUMP_BACKOFF   = 0.4

    local function isKnocked(hum)
        local s = hum:GetState()
        return hum.PlatformStand
            or hum.Sit
            or s == Enum.HumanoidStateType.FallingDown
            or s == Enum.HumanoidStateType.Ragdoll
            or s == Enum.HumanoidStateType.GettingUp
            or s == Enum.HumanoidStateType.PlatformStanding
    end

    while true do
        task.wait(0.05)
        if not getgenv().smartAntiFlingEnabled then
            graceUntil = 0 ; cooldownUntil = 0 ; lastRecover = 0 ; lastArm = 0
            continue
        end

        local char = localPlayer.Character
        if not char then continue end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not (hrp and hum) or hum.Health <= 0 then continue end

        local now = tick()
        local v   = hrp.AssemblyLinearVelocity
        local av  = hrp.AssemblyAngularVelocity
        local hMag = math.sqrt(v.X * v.X + v.Z * v.Z)
        local aMag = av.Magnitude

        local recentlyJumped = (now - lastJumpPress) < JUMP_BACKOFF
        local knocked = isKnocked(hum)
        local realFling = (hMag > FLING_HORIZ) or (aMag > FLING_ANGULAR) or (knocked and not recentlyJumped)

        local inGrace    = now < graceUntil
        local inCooldown = now < cooldownUntil

        -- ARM grace the instant a real fling is detected (no counter)
        if realFling and not inGrace and not inCooldown and (now - lastArm) > ARM_GAP then
            lastArm = now
            if math.random() > SKIP_CHANCE then
                graceUntil = now + GRACE_DURATION
            else
                cooldownUntil = now + math.random(COOLDOWN_MIN, COOLDOWN_MAX)
            end
        end

        -- While in grace: recover single-shot, horizontal-only, Y preserved
        if inGrace and (now - lastRecover) > RECOVER_GAP then
            if hMag > FLING_HORIZ or aMag > FLING_ANGULAR or knocked then
                lastRecover = now
                pcall(function()
                    -- kill horizontal, PRESERVE Y (jump)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
                    if aMag > 40 then
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end
                    -- only exit knock if truly knocked and grounded, never force mid-air
                    if knocked and hum.FloorMaterial ~= Enum.Material.Air then
                        hum.PlatformStand = false
                        hum.Sit = false
                        hum:ChangeState(Enum.HumanoidStateType.Running)
                    end
                end)
            end
        end

        -- Expire grace → cooldown
        if inGrace and now >= graceUntil then
            cooldownUntil = now + math.random(COOLDOWN_MIN, COOLDOWN_MAX)
            graceUntil = 0
        end
    end
end)

