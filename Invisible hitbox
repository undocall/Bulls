-- ═══════════ SMOOTH ANTI-FLING (FALL LIMIT 2-5) ═══════════
task.spawn(function()
    local fallCount = 0
    local maxFalls = math.random(2, 5)
    local isImmune = false
    local lastFall = 0

    while task.wait(0.1) do
        if not getgenv().smartAntiFlingEnabled then
            fallCount = 0
            isImmune = false
            maxFalls = math.random(2, 5)
            continue
        end

        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then continue end

        local state = hum:GetState()
        local isRagdolled = state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown or hum.PlatformStand
        local now = tick()

        -- Count the falls
        if isRagdolled and (now - lastFall) > 2 then
            lastFall = now
            if not isImmune then
                fallCount = fallCount + 1
                if fallCount >= maxFalls then
                    isImmune = true
                    -- Once immune, disable these states permanently
                    pcall(function()
                        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                        hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
                    end)
                end
            end
        end

        -- 🟢 FLING PREVENTION (Only active if spinning out of control)
        local av = hrp.AssemblyAngularVelocity
        local lv = hrp.AssemblyLinearVelocity

        if av.Magnitude > 50 or (isImmune and lv.Magnitude > 100) then
            -- Kill the spin, but PRESERVE forward/upward walking momentum
            hrp.AssemblyAngularVelocity = Vector3.zero
            
            -- Only stop horizontal speed if it's a massive fling, keep the Y (jump/fall)
            if lv.Magnitude > 80 then
                hrp.AssemblyLinearVelocity = Vector3.new(0, lv.Y, 0)
            end
        end
    end
end)

uiLibrary:AddToggle("Smart Anti-Fling (2-5 Limit)", function(enabled)
    getgenv().smartAntiFlingEnabled = enabled
    if not enabled then
        local char = localPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, true)
            end)
        end
    end
    playSound("rbxassetid://12221976")
end, false)

