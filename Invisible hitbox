-- Toggle row helper
local function makeToggle(labelText, yOffset, onClick)
    local row = Instance.new("TextButton")
    row.Size = UDim2.new(1, -12, 0, 26)
    row.Position = UDim2.new(0, 6, 0, yOffset)
    row.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    row.BackgroundTransparency = 0.2
    row.BorderSizePixel = 0
    row.Text = labelText .. "  [ OFF ]"
    row.TextColor3 = Color3.fromRGB(200, 200, 200)
    row.TextSize = 11
    row.Font = Enum.Font.SourceSans
    row.AutoButtonColor = false
    row.Parent = panel

    local rCorner = Instance.new("UICorner")
    rCorner.CornerRadius = UDim.new(0, 4)
    rCorner.Parent = row

    local state = false
    row.MouseButton1Click:Connect(function()
        state = not state
        row.Text = labelText .. (state and "  [ ON ]" or "  [ OFF ]")
        row.TextColor3 = state and Color3.fromRGB(120, 255, 120) or Color3.fromRGB(200, 200, 200)
        onClick(state)
    end)
    return row
end

