-- Helpers
local function isEnemy(player)
    if player == localPlayer then return false end
    local teams = game:GetService("Teams"):GetTeams()
    if #teams > 1 then
        if localPlayer.Team == nil or player.Team == nil then return true end
        return localPlayer.Team ~= player.Team
    end
    return true
end

local function playSound(soundId)
    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Parent = workspace
    pcall(function() sound:Play() end)
    sound.Ended:Connect(function() sound:Destroy() end)
end

-- Config
local hitboxSize = 10

-- Hitbox helpers
local function applyHitbox(character)
    if not character then return end
    local player = Players:GetPlayerFromCharacter(character)
    if player and player == localPlayer then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then return end
    local isR15 = humanoid and humanoid.RigType == Enum.HumanoidRigType.R15

    local function expandPart(part)
        if not part then return end
        if not part:FindFirstChild("OriginalSize") then
            local v = Instance.new("Vector3Value")
            v.Name = "OriginalSize"
            v.Value = part.Size
            v.Parent = part
        end
        part.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
        part.Transparency = 1
        part.CanCollide = false
    end

    expandPart(character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso"))
    if isR15 then expandPart(character:FindFirstChild("LowerTorso")) end

    local head = character:FindFirstChild("Head")
    if head then expandPart(head) ; head.Massless = true end

    if isR15 then
        for _, name in ipairs({"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftUpperLeg","RightUpperLeg"}) do
            expandPart(character:FindFirstChild(name))
        end
    end
end

local function resetHitbox(character)
    if not character then return end
    local player = Players:GetPlayerFromCharacter(character)
    if player and player == localPlayer then return end
    local function restorePart(part)
        if not part then return end
        local orig = part:FindFirstChild("OriginalSize")
        if orig then
            part.Size = orig.Value
            part.Transparency = 1
            part.CanCollide = true
        end
    end
    restorePart(character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso"))
    local head = character:FindFirstChild("Head")
    if head then restorePart(head) ; head.Massless = false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 then
        for _, name in ipairs({"LowerTorso","UpperTorso","LeftUpperArm","RightUpperArm","LeftUpperLeg","RightUpperLeg"}) do
            restorePart(character:FindFirstChild(name))
        end
    end
end

local function applyHitboxesToAllPlayers()
    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemy(p) and p.Character then applyHitbox(p.Character) end
    end
end

local function resetHitboxesOnAllPlayers()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then resetHitbox(p.Character) end
    end
end

local hitboxLoopActive = false
local function toggleHitboxes(enabled)
    hitboxEnabled = enabled
    if enabled then
        applyHitboxesToAllPlayers()
        if not hitboxLoopActive then
            hitboxLoopActive = true
            task.spawn(function()
                while hitboxEnabled do
                    task.wait(0.5)
                    if hitboxEnabled then applyHitboxesToAllPlayers() end
                end
                hitboxLoopActive = false
            end)
        end
    else
        resetHitboxesOnAllPlayers()
    end
end

local function wireHealthChanged(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    humanoid.HealthChanged:Connect(function()
        if not hitboxEnabled then return end
        if humanoid.Health > 0 then applyHitbox(character) else resetHitbox(character) end
    end)
    if hitboxEnabled and humanoid.Health > 0 then applyHitbox(character) end
end

local function trackPlayer(player)
    if not player or not isEnemy(player) then return end
    player.CharacterAdded:Connect(function(character)
        task.wait(1)
        wireHealthChanged(character)
    end)
    if player.Character then wireHealthChanged(player.Character) end
end

for _, p in ipairs(Players:GetPlayers()) do trackPlayer(p) end
Players.PlayerAdded:Connect(trackPlayer)

-- Smart Anti-Fling — Brawl-tuned
task.spawn(function()
    local hitCounter    = 0
    local graceUntil    = 0
    local cooldownUntil = 0
    local nextThreshold = math.random(6, 10)
    local lastHitTime   = 0
    local lastSpeed     = 0
    local HIT_WINDOW    = 1.8
    local HIT_DEBOUNCE  = 0.30
    local SPIKE_MIN     = 55
    local GRACE_DURATION = 30.0
    local COOLDOWN_MIN  = 20.0
    local COOLDOWN_MAX  = 40.0

    local function resetCounter()
        hitCounter    = 0
        nextThreshold = math.random(6, 10)
    end

    while true do
        task.wait(0.05)
        if not getgenv().smartAntiFlingEnabled then
            resetCounter() ; graceUntil = 0 ; cooldownUntil = 0 ; lastSpeed = 0
            continue
        end
        local char = localPlayer.Character
        if not char then resetCounter() ; continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not (hrp and hum) then continue end

        local now      = tick()
        local linVel   = hrp.AssemblyLinearVelocity
        local angVel   = hrp.AssemblyAngularVelocity
        local speed    = linVel.Magnitude
        local horizSpd = Vector3.new(linVel.X, 0, linVel.Z).Magnitude
        local state    = hum:GetState()

        local spike = (speed - lastSpeed) > SPIKE_MIN
        lastSpeed   = speed
        local isFreshHit = spike and (now - lastHitTime) > HIT_DEBOUNCE

        if isFreshHit then lastHitTime = now ; hitCounter = hitCounter + 1 end

        local inGrace    = now < graceUntil
        local inCooldown = now < cooldownUntil

        local isKnocked = hum.PlatformStand or hum.Sit
            or state == Enum.HumanoidStateType.FallingDown
            or state == Enum.HumanoidStateType.Ragdoll
            or state == Enum.HumanoidStateType.GettingUp
            or horizSpd > 90 or angVel.Magnitude > 40

        if inGrace and isKnocked then
            pcall(function()
                hrp.AssemblyLinearVelocity  = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                hum.PlatformStand = false ; hum.Sit = false
                hum:ChangeState(Enum.HumanoidStateType.Running)
                local _, ry, _ = hrp.CFrame:ToOrientation()
                hrp.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, ry, 0)
            end)
        end

        if hitCounter >= nextThreshold and not inGrace and not inCooldown then
            if math.random() < 0.35 then
                cooldownUntil = now + math.random(COOLDOWN_MIN, COOLDOWN_MAX)
                resetCounter()
            else
                graceUntil = now + GRACE_DURATION
                hitCounter = 0
                nextThreshold = math.random(6, 10)
            end
        end

        if not inGrace and not inCooldown and graceUntil > 0 and now >= graceUntil then
            cooldownUntil = now + math.random(COOLDOWN_MIN, COOLDOWN_MAX)
            graceUntil    = 0
            resetCounter()
        end

        if hitCounter > 0 and (now - lastHitTime) > HIT_WINDOW then resetCounter() end
    end
end)

