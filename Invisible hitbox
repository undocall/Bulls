-- [FIX 3] Smart Anti-Fling -- standalone task.spawn loop, not Heartbeat
-- Heartbeat callbacks must not block; this moves all task.wait() out of the signal
task.spawn(function()
    local hitCounter = 0
    local targetThreshold = math.random(3, 4)
    while true do
        task.wait()
        if not getgenv().smartAntiFlingEnabled then
            hitCounter = 0
            task.wait(0.1)
            continue
        end
        local char = localPlayer.Character
        if not char then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not (hrp and hum) then continue end

        local linVel    = hrp.AssemblyLinearVelocity
        local angVel    = hrp.AssemblyAngularVelocity
        local horizSpd  = Vector3.new(linVel.X, 0, linVel.Z).Magnitude
        local state     = hum:GetState()
        local isHit = hum.PlatformStand
            or state == Enum.HumanoidStateType.FallingDown
            or state == Enum.HumanoidStateType.Ragdoll
            or horizSpd > 100
            or angVel.Magnitude > 45

        if isHit then
            hitCounter += 1
            if hitCounter >= targetThreshold then
                pcall(function()
                    hrp.AssemblyLinearVelocity  = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                    hum.PlatformStand = false
                    hum.Sit = false
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                    -- [FIX 2] same CFrame fix applied here
                    local _, ry, _ = hrp.CFrame:ToOrientation()
                    hrp.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 1.8, 0))
                        * CFrame.Angles(0, ry, 0)
                end)
                hitCounter = 0
                targetThreshold = math.random(3, 4)
                task.wait(0.4)
            else
                task.wait(0.3)
            end
        else
            if hitCounter > 0 then
                task.wait(1.5)
                hitCounter = math.max(0, hitCounter - 1)
            end
        end
    end
end)

