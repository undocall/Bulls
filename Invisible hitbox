-- ═══════════ SMOOTH ANTI-FLING (v6.5 — PHYSICS FIXED) ═══════════
task.spawn(function()
    local fallCount  = 0
    local maxFalls   = math.random(3, 4)   -- 3-4 normal flings, then immunity
    local isImmune   = false
    local immuneStart = 0
    local lastFall   = 0
    local currentHum = nil

    local IMMUNITY_DURATION = 2.5   -- short, glitch-like, not hack-like

    -- caps applied ONLY while immune (never zeroed — that's what made it "solid rock")
    local CAP_HORIZ   = 45
    local CAP_VERT_UP = 90
    local CAP_ANGULAR = 12

    RunService.Heartbeat:Connect(function()
        if not getgenv().smartAntiFlingEnabled then
            fallCount  = 0
            isImmune   = false
            currentHum = nil
            return
        end

        local char = localPlayer.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        -- respawn reset
        if hum ~= currentHum then
            currentHum = hum
            fallCount  = 0
            maxFalls   = math.random(3, 4)
            isImmune   = false
        end

        local now = tick()

        -- immunity expiry → back to normal cycle
        if isImmune and (now - immuneStart > IMMUNITY_DURATION) then
            isImmune  = false
            fallCount = 0
            maxFalls  = math.random(3, 4)
            print("[AntiFling] immunity expired — back to normal")
        end

        local state = hum:GetState()
        local isRagdolled = (state == Enum.HumanoidStateType.Ragdoll
            or state == Enum.HumanoidStateType.FallingDown
            or state == Enum.HumanoidStateType.Physics
            or hum.PlatformStand)

        -- count normal flings (only when not immune)
        if isRagdolled and not isImmune and (now - lastFall > 1.0) then
            lastFall = now
            fallCount = fallCount + 1
            print(string.format("[AntiFling] fall %d/%d — %s", fallCount, maxFalls, tostring(state)))
            if fallCount >= maxFalls then
                isImmune    = true
                immuneStart = now
                print("[AntiFling] IMMUNITY ACTIVE (2.5s)")
            end
        end

        -- during immunity: cap physics + fast wake-up, but only when it won't fight the game
        if isImmune then
            local av = hrp.AssemblyAngularVelocity
            local lv = hrp.AssemblyLinearVelocity

            -- cap spin
            if av.Magnitude > CAP_ANGULAR then
                hrp.AssemblyAngularVelocity = av.Unit * CAP_ANGULAR
            end

            -- cap horizontal (no fly) — CAP, not zero
            local horiz = Vector3.new(lv.X, 0, lv.Z).Magnitude
            if horiz > CAP_HORIZ then
                local capped = Vector3.new(lv.X, 0, lv.Z).Unit * CAP_HORIZ
                hrp.AssemblyLinearVelocity = Vector3.new(capped.X, lv.Y, capped.Z)
            end

            -- cap upward (no sky launch)
            if lv.Y > CAP_VERT_UP then
                local cur = hrp.AssemblyLinearVelocity
                hrp.AssemblyLinearVelocity = Vector3.new(cur.X, CAP_VERT_UP, cur.Z)
            end

            -- fast wake-up: ONLY when grounded AND stuck in a ragdoll state
            -- (never in air — that caused the "bounce back" and "won't wake up")
            if hum.FloorMaterial ~= Enum.Material.Air then
                if hum.PlatformStand then hum.PlatformStand = false end
                if hum.Sit           then hum.Sit           = false end

                if state == Enum.HumanoidStateType.Ragdoll
                   or state == Enum.HumanoidStateType.FallingDown
                   or state == Enum.HumanoidStateType.Physics then
                    pcall(function()
                        hum:ChangeState(Enum.HumanoidStateType.Running)
                    end)
                end
            end
        end
    end)
end)

