-- [FIX 1] GOD Kill-Aura -- renamed to godAuraRange so global autohit can't shadow it
-- was sharing reachRange/rangeSquared with global autohit, running at 15000 studs
local godAuraRange   = 50
local godAuraRangeSq = godAuraRange * godAuraRange

uiLibrary:AddToggle("GOD Kill-Aura (No-Lag)", function(enabled)
    getgenv().godAuraEnabled = enabled
    playSound("rbxassetid://12221976")
    if enabled then
        if not getgenv().godAuraConnection then
            getgenv().godAuraConnection = RunService.PreRender:Connect(function()
                if not getgenv().godAuraEnabled then return end
                local char = localPlayer.Character
                if not char then return end
                local myRoot = char:FindFirstChild("HumanoidRootPart")
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if not (myRoot and humanoid and humanoid.Health > 0) then return end

                local tool = char:FindFirstChildOfClass("Tool")
                if not tool then
                    local bp = localPlayer:FindFirstChild("Backpack")
                    if bp then
                        local found = bp:FindFirstChildOfClass("Tool")
                        if found then humanoid:EquipTool(found) end
                    end
                    return
                end
                local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
                if not handle then return end

                tool:Activate()
                local myPos = myRoot.Position

                for _, player in ipairs(Players:GetPlayers()) do
                    if isEnemy(player) and player.Character then
                        local eChar = player.Character
                        local eHum  = eChar:FindFirstChildOfClass("Humanoid")
                        local eRoot = eChar:FindFirstChild("HumanoidRootPart")
                            or eChar:FindFirstChild("UpperTorso")
                        if eRoot and eHum and eHum.Health > 0 then
                            local d = myPos - eRoot.Position
                            -- [FIX 1] uses godAuraRangeSq (2500), not global's 225,000,000
                            if d.X*d.X + d.Y*d.Y + d.Z*d.Z <= godAuraRangeSq then
                                for _, part in ipairs({
                                    eRoot,
                                    eChar:FindFirstChild("Head"),
                                    eChar:FindFirstChild("UpperTorso"),
                                    eChar:FindFirstChild("LowerTorso")
                                }) do
                                    if part and firetouchinterest then
                                        firetouchinterest(handle, part, 0)
                                        firetouchinterest(handle, part, 1)
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    else
        if getgenv().godAuraConnection then
            getgenv().godAuraConnection:Disconnect()
            getgenv().godAuraConnection = nil
        end
    end
end, false)

-- [FIX 1] Global Autohit -- own range vars, no longer shadows God Aura
-- [FIX 3] Blocking task.wait() moved into task.spawn so Heartbeat doesn't stall
local globalReachRange = 15000
local globalRangeSq    = globalReachRange * globalReachRange

uiLibrary:AddToggle("Global Autohit / Fling (Cross-map)", function(enabled)
    getgenv().globalAuraEnabled = enabled
    playSound("rbxassetid://12221976")
    if enabled then
        if not getgenv().globalAuraConnection then
            getgenv().globalAuraConnection = RunService.Heartbeat:Connect(function()
                if not getgenv().globalAuraEnabled then return end
                local char = localPlayer.Character
                if not char then return end
                local myRoot  = char:FindFirstChild("HumanoidRootPart")
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if not (myRoot and humanoid and humanoid.Health > 0) then return end

                local originalCFrame = myRoot.CFrame
                local tool   = char:FindFirstChildOfClass("Tool")
                local handle = tool and (
                    tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
                )

                for _, player in ipairs(Players:GetPlayers()) do
                    if isEnemy(player) and player.Character then
                        local eChar = player.Character
                        local eHum  = eChar:FindFirstChildOfClass("Humanoid")
                        local eRoot = eChar:FindFirstChild("HumanoidRootPart")
                            or eChar:FindFirstChild("UpperTorso")
                        if eRoot and eHum and eHum.Health > 0 then
                            local d = originalCFrame.Position - eRoot.Position
                            if d.X*d.X + d.Y*d.Y + d.Z*d.Z <= globalRangeSq then
                                -- [FIX 3] spawn so Heartbeat thread returns immediately
                                local snapBack = originalCFrame
                                task.spawn(function()
                                    myRoot.CFrame = eRoot.CFrame * CFrame.new(0, 0, 1)
                                    myRoot.AssemblyLinearVelocity  = Vector3.zero
                                    myRoot.AssemblyAngularVelocity = Vector3.new(100000, 100000, 100000)
                                    if tool and handle then
                                        tool:Activate()
                                        if firetouchinterest then
                                            firetouchinterest(handle, eRoot, 0)
                                            firetouchinterest(handle, eRoot, 1)
                                        end
                                    end
                                    task.wait(0.01)
                                    myRoot.AssemblyAngularVelocity = Vector3.zero
                                    myRoot.AssemblyLinearVelocity  = Vector3.zero
                                    myRoot.CFrame = snapBack
                                end)
                            end
                        end
                    end
                end
            end)
        end
    else
        if getgenv().globalAuraConnection then
            getgenv().globalAuraConnection:Disconnect()
            getgenv().globalAuraConnection = nil
        end
    end
end, false)

