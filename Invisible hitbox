-- === SMART ANTI-FLING — ground-landing counter ===
-- Grace chance ~80% (SKIP_CHANCE 0.20). Velocity-aware skip = higher effective grace.
task.spawn(function()
    local fallCounter   = 0
    local graceUntil    = 0
    local cooldownUntil = 0
    local nextThreshold = math.random(2, 3)   -- was 2-4, tighter
    local lastFallTime  = 0
    local wasGrounded   = true

    local FALL_WINDOW    = 4.0
    local FALL_DEBOUNCE  = 0.5
    local GRACE_DURATION = 45.0
    local COOLDOWN_MIN   = 12.0
    local COOLDOWN_MAX   = 25.0
    local SKIP_CHANCE    = 0.20   -- was 0.25 → now 80% grace
    local FLING_VELOCITY = 50
    local FAST_VELOCITY  = 80     -- above this, skip the roll entirely
    local FAST_WINDOW    = 1.2    -- how recent fast movement counts

    local fastUntil = 0

    local function resetCounter()
        fallCounter   = 0
        nextThreshold = math.random(2, 3)
    end

    while true do
        task.wait(0.06)
        if not getgenv().smartAntiFlingEnabled then
            resetCounter() ; graceUntil = 0 ; cooldownUntil = 0
            wasGrounded = true ; fastUntil = 0
            continue
        end

        local char = localPlayer.Character
        if not char then resetCounter() ; continue end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not (hrp and hum) then continue end

        local now   = tick()
        local state = hum:GetState()

        -- track recent high velocity (real fling signal)
        local vmag = hrp.AssemblyLinearVelocity.Magnitude
        if vmag > FAST_VELOCITY then
            fastUntil = now + FAST_WINDOW
        end

        local isKnocked = hum.PlatformStand or hum.Sit
            or state == Enum.HumanoidStateType.FallingDown
            or state == Enum.HumanoidStateType.Ragdoll
            or state == Enum.HumanoidStateType.GettingUp

        local rp = RaycastParams.new()
        rp.FilterDescendantsInstances = {char}
        rp.FilterType = Enum.RaycastFilterType.Exclude
        local floorHit = workspace:Raycast(hrp.Position, Vector3.new(0, -3.5, 0), rp)
        local grounded = (floorHit ~= nil) or (hum.FloorMaterial ~= Enum.Material.Air)

        local justLanded = grounded and (not wasGrounded)
        local freshFall  = (isKnocked and justLanded and (now - lastFallTime) > FALL_DEBOUNCE)
                        or (isKnocked and grounded   and (now - lastFallTime) > FALL_DEBOUNCE)

        if freshFall then
            lastFallTime = now
            fallCounter  = fallCounter + 1
        end

        wasGrounded = grounded

        local inGrace    = now < graceUntil
        local inCooldown = now < cooldownUntil

        if inGrace then
            pcall(function()
                hrp.AssemblyAngularVelocity = Vector3.zero
                local v = hrp.AssemblyLinearVelocity
                if v.Magnitude > FLING_VELOCITY then
                    hrp.AssemblyLinearVelocity = Vector3.new(0, math.min(v.Y, 0), 0)
                end
                if isKnocked then
                    hum.PlatformStand = false ; hum.Sit = false
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                    local _, ry, _ = hrp.CFrame:ToOrientation()
                    hrp.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 1.5, 0))
                               * CFrame.Angles(0, ry, 0)
                end
            end)
        end

        if fallCounter >= nextThreshold and not inGrace and not inCooldown then
            -- velocity-aware: if we just saw real fling speed, auto-arm grace
            local flingSignal = now < fastUntil
            if not flingSignal and math.random() < SKIP_CHANCE then
                cooldownUntil = now + math.random(COOLDOWN_MIN, COOLDOWN_MAX)
                resetCounter()
            else
                graceUntil    = now + GRACE_DURATION
                fallCounter   = 0
                nextThreshold = math.random(2, 3)
            end
        end

        if not inGrace and not inCooldown and graceUntil > 0 and now >= graceUntil then
            cooldownUntil = now + math.random(COOLDOWN_MIN, COOLDOWN_MAX)
            graceUntil    = 0
            resetCounter()
        end

        if fallCounter > 0 and (now - lastFallTime) > FALL_WINDOW then
            resetCounter()
        end
    end
end)

