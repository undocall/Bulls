-- Hitbox helpers
local function applyHitbox(character)
    if not character then return end
    local player = Players:GetPlayerFromCharacter(character)
    if player and player == localPlayer then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then return end
    local isR15 = humanoid and humanoid.RigType == Enum.HumanoidRigType.R15

    local function expandPart(part)
        if not part then return end
        if not part:FindFirstChild("OriginalSize") then
            local v = Instance.new("Vector3Value")
            v.Name = "OriginalSize"
            v.Value = part.Size
            v.Parent = part
        end
        part.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
        part.Transparency = 1
        part.CanCollide = false
    end

    local rootPart = character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("UpperTorso")
    expandPart(rootPart)
    if isR15 then expandPart(character:FindFirstChild("LowerTorso")) end

    local head = character:FindFirstChild("Head")
    if head then
        expandPart(head)
        head.Massless = true
    end

    if isR15 then
        for _, name in ipairs({
            "UpperTorso", "LowerTorso",
            "LeftUpperArm", "RightUpperArm",
            "LeftUpperLeg", "RightUpperLeg"
        }) do
            expandPart(character:FindFirstChild(name))
        end
    end
end

local function resetHitbox(character)
    if not character then return end
    local player = Players:GetPlayerFromCharacter(character)
    if player and player == localPlayer then return end

    local function restorePart(part)
        if not part then return end
        local orig = part:FindFirstChild("OriginalSize")
        if orig then
            part.Size = orig.Value
            part.Transparency = 1
            part.CanCollide = true
        end
    end

    restorePart(character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("UpperTorso"))

    local head = character:FindFirstChild("Head")
    if head then restorePart(head) ; head.Massless = false end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 then
        for _, name in ipairs({
            "LowerTorso", "UpperTorso",
            "LeftUpperArm", "RightUpperArm",
            "LeftUpperLeg", "RightUpperLeg"
        }) do
            restorePart(character:FindFirstChild(name))
        end
    end
end

local function applyHitboxesToAllPlayers()
    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemy(p) and p.Character then applyHitbox(p.Character) end
    end
end

local function resetHitboxesOnAllPlayers()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then resetHitbox(p.Character) end
    end
end

-- [FIX 3] Hitbox loop -- task.spawn instead of raw coroutine
local hitboxLoopActive = false
local function toggleHitboxes(enabled)
    hitboxEnabled = enabled
    playSound("rbxassetid://12221976")
    pcall(function()
        if hitboxIncreaseButton and hitboxDecreaseButton then
            hitboxIncreaseButton.Visible = enabled
            hitboxDecreaseButton.Visible = enabled
        end
    end)
    if enabled then
        applyHitboxesToAllPlayers()
        if not hitboxLoopActive then
            hitboxLoopActive = true
            task.spawn(function()
                while hitboxEnabled do
                    task.wait(0.5)
                    if hitboxEnabled then applyHitboxesToAllPlayers() end
                end
                hitboxLoopActive = false
            end)
        end
    else
        resetHitboxesOnAllPlayers()
    end
end

-- ESP
local function createESP(player)
    if espGuis[player] then
        espGuis[player]:Destroy()
        espGuis[player] = nil
    end
    if not player or not player.Character or player == localPlayer then return end
    if not isEnemy(player) then return end

    local head = player.Character:FindFirstChild("Head")
    local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
        or player.Character:FindFirstChild("UpperTorso")
    local targetPart = head or rootPart
    if not targetPart then return end

    local espGui = Instance.new("BillboardGui")
    espGui.Name = "ESP"
    espGui.Adornee = targetPart
    espGui.Size = UDim2.new(0, 100, 0, 50)
    espGui.StudsOffset = Vector3.new(0, 2, 0)
    espGui.AlwaysOnTop = true

    local espLabel = Instance.new("TextLabel", espGui)
    espLabel.Size = UDim2.new(1, 0, 1, 0)
    espLabel.BackgroundTransparency = 1
    espLabel.TextColor3 = Color3.new(1, 0, 0)
    espLabel.TextStrokeTransparency = 0
    espLabel.Text = player.Name
    espLabel.TextScaled = true
    espLabel.Font = Enum.Font.SourceSansBold

    espGuis[player] = espGui
    espGui.Parent = targetPart

    local lastUpdate = tick()
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not espGui or not espGui.Parent then
            connection:Disconnect()
            return
        end
        if (tick() - lastUpdate) < 0.1 then return end
        lastUpdate = tick()
        if not player.Character or not localPlayer.Character then return end
        local pRoot = player.Character:FindFirstChild("HumanoidRootPart")
            or player.Character:FindFirstChild("UpperTorso")
        local lRoot = localPlayer.Character:FindFirstChild("HumanoidRootPart")
            or localPlayer.Character:FindFirstChild("UpperTorso")
        if not (pRoot and lRoot) then return end
        local dist = (lRoot.Position - pRoot.Position).Magnitude
        local sz = math.clamp(100 - dist * 0.5, 10, 100)
        espGui.Size = UDim2.new(0, sz, 0, sz * 0.5)
    end)
end

local function toggleESP(enabled)
    espEnabled = enabled
    playSound("rbxassetid://12221976")
    if enabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if isEnemy(p) then createESP(p) end
        end
    else
        -- [FIX 5] nil keys explicitly, then reset table
        for player, gui in pairs(espGuis) do
            if gui then gui:Destroy() end
            espGuis[player] = nil
        end
        espGuis = {}
    end
end

-- [FIX 4] trackPlayer -- wire HealthChanged for both new and existing characters
local function wireHealthChanged(player, character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    humanoid.HealthChanged:Connect(function()
        if not hitboxEnabled then return end
        if humanoid.Health > 0 then
            applyHitbox(character)
        else
            resetHitbox(character)
        end
    end)
    if hitboxEnabled and humanoid.Health > 0 then
        applyHitbox(character)
    end
end

local function trackPlayer(player)
    if not player or not isEnemy(player) then return end
    player.CharacterAdded:Connect(function(character)
        task.wait(1)
        wireHealthChanged(player, character)
        if espEnabled then createESP(player) end
    end)
    -- [FIX 4] existing character gets HealthChanged too
    if player.Character then
        wireHealthChanged(player, player.Character)
        if espEnabled then createESP(player) end
    end
end

for _, p in ipairs(Players:GetPlayers()) do trackPlayer(p) end
Players.PlayerAdded:Connect(trackPlayer)
Players.PlayerRemoving:Connect(function(player)
