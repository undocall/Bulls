local isMenuOpen = true
toggleBtn.MouseButton1Click:Connect(function()
    isMenuOpen = not isMenuOpen
    playSound("rbxassetid://12221976")
    local function setVisible(guiRoot)
        for _, gui in ipairs(guiRoot:GetChildren()) do
            if gui ~= toggleGui and gui:IsA("ScreenGui") then
                for _, child in ipairs(gui:GetChildren()) do
                    if child:IsA("Frame") then child.Visible = isMenuOpen end
                end
            end
        end
    end
    setVisible(CoreGui)
    local pg = localPlayer:FindFirstChild("PlayerGui")
    if pg then setVisible(pg) end
end)
