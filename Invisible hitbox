-- ═══════════ SMART ANTI-FLING v6.6 (PRE-PHYSICS CLAMP + CYCLE) ═══════════
local af_fallCount    = 0
local af_maxFalls     = math.random(3, 4)
local af_isImmune     = false
local af_immuneStart  = 0
local af_immuneDur    = 2.5
local af_lastFling    = 0
local af_safePos      = nil
local af_currentHum   = nil

local function af_setRestrictions(hum, restrict)
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,      not restrict)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown,  not restrict)
        hum:SetStateEnabled(Enum.HumanoidStateType.Physics,      not restrict)
        hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, not restrict)
    end)
end

local function af_reset(hum, reason)
    af_isImmune    = false
    af_fallCount   = 0
    af_maxFalls    = math.random(3, 4)
    af_safePos     = nil
    if hum then af_setRestrictions(hum, false) end
    if antiFlingDebug and reason then print("[AntiFling] reset — "..reason) end
end

RunService.Stepped:Connect(function()
    if not antiFlingEnabled then
        if af_isImmune or af_fallCount > 0 then
            local char = localPlayer.Character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            af_reset(hum, "toggle off")
        end
        af_currentHum = nil
        return
    end

    local char = localPlayer.Character
    local hrp  = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso"))
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    -- respawn tracking (do NOT reset fallCount — keep progress)
    if hum ~= af_currentHum then
        af_currentHum = hum
        af_safePos    = hrp.Position
    end

    local now  = tick()
    local pos  = hrp.Position
    local vel  = hrp.AssemblyLinearVelocity
    local av   = hrp.AssemblyAngularVelocity
    local state = hum:GetState()

    -- ── expiry ──
    if af_isImmune and (now - af_immuneStart > af_immuneDur) then
        af_reset(hum, "immunity expired — re-arm after "..af_maxFalls.." hits")
    end

    -- ── detection (only when NOT immune) ──
    if not af_isImmune then
        local ragdolled = (state == Enum.HumanoidStateType.Ragdoll
            or state == Enum.HumanoidStateType.FallingDown
            or state == Enum.HumanoidStateType.Physics
            or hum.PlatformStand == true)

        local hugeVel = vel.Magnitude > 90
        local jumped  = af_safePos and (pos - af_safePos).Magnitude > 15

        if (ragdolled or hugeVel or jumped) and (now - af_lastFling > 1.2) then
            af_lastFling = now
            af_fallCount = af_fallCount + 1
            if antiFlingDebug then
                print(string.format("[AntiFling] HIT %d/%d  (state=%s vel=%.0f jump=%.0f)",
                    af_fallCount, af_maxFalls, tostring(state), vel.Magnitude,
                    af_safePos and (pos - af_safePos).Magnitude or 0))
            end

            if af_fallCount >= af_maxFalls then
                af_isImmune    = true
                af_immuneStart = now
                af_safePos     = pos
                af_setRestrictions(hum, true)
                if antiFlingDebug then print("[AntiFling] >>> IMMUNITY ACTIVE for "..af_immuneDur.."s") end
            else
                af_safePos = pos
            end
        else
            -- still walking normally — keep safe anchor current
            if (not af_safePos) or (pos - af_safePos).Magnitude < 10 then
                af_safePos = pos
            end
        end
        return
    end

    -- ═══ IMMUNE ═══
    -- 1. clamp velocity BEFORE physics integrates it
    local horiz = Vector3.new(vel.X, 0, vel.Z)
    local hMag  = horiz.Magnitude
    local nx, ny, nz = vel.X, vel.Y, vel.Z
    if hMag > 25 then
        nx = horiz.Unit.X * 25
        nz = horiz.Unit.Z * 25
    end
    if ny >  55 then ny =  55 end
    if ny < -120 then ny = -120 end
    hrp.AssemblyLinearVelocity = Vector3.new(nx, ny, nz)

    if av.Magnitude > 5 then
        hrp.AssemblyAngularVelocity = av.Unit * 5
    end

    -- 2. position snap-back (catches CFrame-teleport flings)
    if af_safePos then
        local delta = (pos - af_safePos).Magnitude
        if delta > 12 then
            local dir    = (pos - af_safePos).Unit
            local target = af_safePos + dir * 6
            hrp.CFrame = CFrame.new(target, target + hrp.CFrame.LookVector)
            if antiFlingDebug then print(string.format("[AntiFling] snap-back (delta %.0f)", delta)) end
        elseif delta < 6 then
            af_safePos = pos
        end
    end

    -- 3. force out of any ragdoll / stuck state
    if hum.PlatformStand then hum.PlatformStand = false end
    if hum.Sit           then hum.Sit           = false end

    if state == Enum.HumanoidStateType.Ragdoll
       or state == Enum.HumanoidStateType.FallingDown
       or state == Enum.HumanoidStateType.Physics then
        pcall(function()
            if hum.FloorMaterial ~= Enum.Material.Air then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            else
                hum:ChangeState(Enum.HumanoidStateType.Freefall)
            end
        end)
    end
end)

