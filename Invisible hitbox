-- RELIABLE SMART ANTI-FLING & LOOP BREAK SYSTEM
------------------------------------------------------------------
getgenv().smartAntiFlingEnabled = false
local consecutiveHits = 0

uiLibrary:AddToggle("Smart Anti-Fling", function(enabled)
    getgenv().smartAntiFlingEnabled = enabled
    playSound("rbxassetid://12221976")
    consecutiveHits = 0
end, false)

RunService.Heartbeat:Connect(function()
    if not getgenv().smartAntiFlingEnabled then return end
    local char = localPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum) then return end

    local linVel = hrp.AssemblyLinearVelocity
    local angVel = hrp.AssemblyAngularVelocity
    local horizSpeed = Vector3.new(linVel.X, 0, linVel.Z).Magnitude
    local state = hum:GetState()
    
    -- Detects hits, ragdolls, high velocity, or getting knocked
    local isKnockedOrHit = (hum.PlatformStand or state == Enum.HumanoidStateType.FallingDown or state == Enum.HumanoidStateType.Ragdoll or horizSpeed > 120 or angVel.Magnitude > 50)

    if isKnockedOrHit then
        consecutiveHits = consecutiveHits + 1
        -- Once you hit 2-3 consecutive impacts/falls, it always triggers to break the loop and prevent endless cycling
        if consecutiveHits >= 2 then
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                hum.PlatformStand = false
                hum.Sit = false
                hum:ChangeState(Enum.HumanoidStateType.Running)
                local currentPos = hrp.Position
                hrp.CFrame = CFrame.new(currentPos + Vector3.new(0, 2, 0)) * select(2, hrp.CFrame:ToOrientation())
            end)
            consecutiveHits = 0
        end
    else
        -- Gradually cool down hit counter when stable
        if consecutiveHits > 0 then
            consecutiveHits = math.max(0, consecutiveHits - 0.05)
        end
    end
end)

