-- Smart Anti-Fling — natural bug simulation
task.spawn(function()
    local hitCounter    = 0
    local graceUntil    = 0
    local cooldownUntil = 0
    local nextThreshold = math.random(3, 5)
    local lastHitTime   = 0
    local HIT_WINDOW    = 3.0
    local GRACE_DURATION = 30.0
    local COOLDOWN_MIN  = 25.0
    local COOLDOWN_MAX  = 45.0

    local function resetCounter()
        hitCounter    = 0
        nextThreshold = math.random(3, 5)
    end

    while true do
        task.wait(0.08)
        if not getgenv().smartAntiFlingEnabled then
            resetCounter()
            graceUntil    = 0
            cooldownUntil = 0
            continue
        end

        local char = localPlayer.Character
        if not char then resetCounter() ; continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not (hrp and hum) then continue end

        local now      = tick()
        local linVel   = hrp.AssemblyLinearVelocity
        local angVel   = hrp.AssemblyAngularVelocity
        local horizSpd = Vector3.new(linVel.X, 0, linVel.Z).Magnitude
        local state    = hum:GetState()

        local isKnocked = hum.PlatformStand
            or hum.Sit
            or state == Enum.HumanoidStateType.FallingDown
            or state == Enum.HumanoidStateType.Ragdoll
            or state == Enum.HumanoidStateType.GettingUp
            or horizSpd > 90
            or angVel.Magnitude > 40

        local freshHit = isKnocked and (now - lastHitTime) > 0.8

        if freshHit then
            lastHitTime = now
            hitCounter += 1
        end

        local inGrace    = now < graceUntil
        local inCooldown = now < cooldownUntil

        if inGrace and isKnocked then
            pcall(function()
                hrp.AssemblyLinearVelocity  = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                hum.PlatformStand = false
                hum.Sit = false
                hum:ChangeState(Enum.HumanoidStateType.Running)
                local _, ry, _ = hrp.CFrame:ToOrientation()
                hrp.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 1.5, 0))
                    * CFrame.Angles(0, ry, 0)
            end)
        end

        if hitCounter >= nextThreshold and not inGrace and not inCooldown then
            if math.random() < 0.35 then
                cooldownUntil = now + math.random(COOLDOWN_MIN, COOLDOWN_MAX)
                resetCounter()
            else
                graceUntil    = now + GRACE_DURATION
                hitCounter    = 0
                nextThreshold = math.random(3, 5)
            end
        end

        if not inGrace and not inCooldown and graceUntil > 0 and now >= graceUntil then
            cooldownUntil = now + math.random(COOLDOWN_MIN, COOLDOWN_MAX)
            graceUntil    = 0
            resetCounter()
        end

        if hitCounter > 0 and (now - lastHitTime) > HIT_WINDOW then
            resetCounter()
        end
    end
end)

