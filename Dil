    label.Font = Enum.Font.GothamBold
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 8
    label.Parent = card

    -- Value display pill
    local valuePill = Instance.new("Frame")
    valuePill.Size = UDim2.new(0, 42, 0, 26)
    valuePill.Position = UDim2.new(0.5, -21, 0.5, -13)
    valuePill.BackgroundColor3 = C.void
    valuePill.BorderSizePixel = 0
    valuePill.ZIndex = 8
    valuePill.Parent = card
    addCorner(valuePill, 6)
    addGlowStroke(valuePill, C.arcane, nil, 1, 0.4)

    local valueText = Instance.new("TextLabel")
    valueText.Size = UDim2.new(1, 0, 1, 0)
    valueText.BackgroundTransparency = 1
    valueText.Text = tostring(initVal)
    valueText.TextColor3 = C.flame
    valueText.Font = Enum.Font.GothamBold
    valueText.TextSize = 13
    valueText.ZIndex = 9
    valueText.Parent = valuePill

    local cur = initVal

    local function makeStepBtn(symbol, xPos)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 28, 0, 28)
        btn.Position = xPos
        btn.BackgroundColor3 = C.tomb
        btn.BackgroundTransparency = 0.1
        btn.Text = symbol
        btn.TextColor3 = C.flame
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 16
        btn.AutoButtonColor = false
        btn.ZIndex = 9
        btn.Parent = card
        addCorner(btn, 7)
        addGlowStroke(btn, C.arcane, nil, 1, 0.4)

        btn.MouseEnter:Connect(function() tw(btn, 0.1, {BackgroundColor3 = C.crypt, TextColor3 = C.spark}):Play() end)
        btn.MouseLeave:Connect(function() tw(btn, 0.1, {BackgroundColor3 = C.tomb, TextColor3 = C.flame}):Play() end)
        btn.MouseButton1Down:Connect(function() tw(btn, 0.07, {BackgroundColor3 = C.coal}):Play() end)
        btn.MouseButton1Up:Connect(function() tw(btn, 0.1, {BackgroundColor3 = C.tomb}):Play() end)
        return btn
    end

    local minusBtn = makeStepBtn("−", UDim2.new(1, -90, 0.5, -14))
    local plusBtn  = makeStepBtn("+", UDim2.new(1, -34, 0.5, -14))

    minusBtn.MouseButton1Click:Connect(function()
        cur = math.clamp(cur - step, minVal, maxVal)
        valueText.Text = tostring(cur)
        tw(valueText, 0.1, {TextColor3 = C.ember}):Play()
        task.delay(0.15, function() tw(valueText, 0.15, {TextColor3 = C.flame}):Play() end)
        if onChange then onChange(cur) end
    end)
    plusBtn.MouseButton1Click:Connect(function()
        cur = math.clamp(cur + step, minVal, maxVal)
        valueText.Text = tostring(cur)
        tw(valueText, 0.1, {TextColor3 = C.spark}):Play()
        task.delay(0.15, function() tw(valueText, 0.15, {TextColor3 = C.flame}):Play() end)
        if onChange then onChange(cur) end
    end)

    return {setValue = function(v) cur = math.clamp(v, minVal, maxVal); valueText.Text = tostring(cur) end}
end

