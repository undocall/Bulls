    knob.Parent = track
    addCorner(knob, 7)
    local knobStroke = addGlowStroke(knob, C.dust, nil, 1, 0.4)

    local isOn = false

    local function updateSwitch()
        if isOn then
            tw(track, 0.18, {BackgroundColor3 = C.toxicDark}):Play()
            tw(knob, 0.18, {Position = UDim2.new(0, 23, 0.5, -7), BackgroundColor3 = C.toxic}):Play()
            tw(trackStroke, 0.18, {Color = C.toxic, Transparency = 0.1}):Play()
            tw(knobStroke, 0.18, {Color = C.toxic, Transparency = 0.2}):Play()
            tw(cardStroke, 0.18, {Color = C.toxicDark, Transparency = 0.3}):Play()
            tw(label, 0.18, {TextColor3 = C.bone}):Play()
        else
            tw(track, 0.18, {BackgroundColor3 = Color3.fromRGB(20, 12, 30)}):Play()
            tw(knob, 0.18, {Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = C.ash}):Play()
            tw(trackStroke, 0.18, {Color = C.dust, Transparency = 0.3}):Play()
            tw(knobStroke, 0.18, {Color = C.dust, Transparency = 0.4}):Play()
            tw(cardStroke, 0.18, {Color = C.arcane, Transparency = 0.55}):Play()
            tw(label, 0.18, {TextColor3 = C.bone}):Play()
        end
    end

    local hitBtn = Instance.new("TextButton")
    hitBtn.Size = UDim2.new(1, 0, 1, 0)
    hitBtn.BackgroundTransparency = 1
    hitBtn.Text = ""
    hitBtn.ZIndex = 10
    hitBtn.Parent = card

    hitBtn.MouseButton1Down:Connect(function()
        tw(card, 0.08, {BackgroundTransparency = 0}):Play()
    end)
    hitBtn.MouseButton1Up:Connect(function()
        tw(card, 0.12, {BackgroundTransparency = 0.06}):Play()
    end)
    hitBtn.MouseLeave:Connect(function()
        tw(card, 0.12, {BackgroundTransparency = 0.06}):Play()
    end)
    hitBtn.MouseButton1Click:Connect(function()
        isOn = not isOn
        updateSwitch()
        playSound("rbxassetid://12221976")
        if callback then callback(isOn) end
    end)
    hitBtn.MouseEnter:Connect(function()
        tw(card, 0.12, {BackgroundColor3 = C.crypt}):Play()
    end)
    hitBtn.MouseLeave:Connect(function()
        tw(card, 0.12, {BackgroundColor3 = C.manor}):Play()
    end)

    return {
        set = function(v)
            isOn = v
            updateSwitch()
            if callback then callback(v) end
        end
    }
end

