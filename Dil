    page.ScrollBarImageTransparency = 0.4
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.ZIndex = 6
    page.Parent = contentArea
    addListLayout(page, 5)
    addPadding(page, 4, 12, 4, 4)
    pages[name] = page

    -- Sidebar tab button
    local sb = Instance.new("TextButton")
    sb.Name = name .. "_tab"
    sb.Size = UDim2.new(1, 0, 0, 36)
    sb.BackgroundColor3 = C.grave
    sb.BackgroundTransparency = 0.25
    sb.Text = ""
    sb.AutoButtonColor = false
    sb.ZIndex = 7
    sb.Parent = sidebar
    addCorner(sb, 7)

    -- Tab background gradient
    local sbGrad = Instance.new("UIGradient")
    sbGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.0, C.crypt),
        ColorSequenceKeypoint.new(1.0, C.tomb),
    })
    sbGrad.Rotation = 0
    sbGrad.Parent = sb

    -- Tab border (inactive = subtle arcane, active = ember)
    local sbStroke = Instance.new("UIStroke")
    sbStroke.Color = C.arcane
    sbStroke.Thickness = 1
    sbStroke.Transparency = 0.6
    sbStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    sbStroke.Parent = sb

    -- Active indicator bar (left edge, hidden when inactive)
    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 3, 0.65, 0)
    indicator.Position = UDim2.new(0, 0, 0.175, 0)
    indicator.BackgroundColor3 = C.ember
    indicator.BackgroundTransparency = 1
    indicator.BorderSizePixel = 0
    indicator.ZIndex = 8
    indicator.Parent = sb
    addCorner(indicator, 2)

    -- Icon
    local sbIcon = Instance.new("TextLabel")
    sbIcon.Size = UDim2.new(0, 22, 1, 0)
    sbIcon.Position = UDim2.new(0, 6, 0, 0)
    sbIcon.BackgroundTransparency = 1
    sbIcon.Text = icon or "·"
    sbIcon.TextSize = 14
    sbIcon.TextColor3 = C.ash
    sbIcon.Font = Enum.Font.GothamBold
    sbIcon.ZIndex = 8
    sbIcon.Parent = sb

    -- Label
    local sbText = Instance.new("TextLabel")
    sbText.Size = UDim2.new(1, -32, 1, 0)
    sbText.Position = UDim2.new(0, 30, 0, 0)
    sbText.BackgroundTransparency = 1
    sbText.Text = name
    sbText.TextColor3 = C.ash
    sbText.Font = Enum.Font.GothamBold
    sbText.TextSize = 12
    sbText.TextXAlignment = Enum.TextXAlignment.Left
    sbText.ZIndex = 8
    sbText.Parent = sb

    sideBtns[name] = {btn = sb, stroke = sbStroke, text = sbText, icon = sbIcon, bar = indicator, grad = sbGrad}

    local function setActive()
        for pn, pg in pairs(pages) do pg.Visible = (pn == name) end
        for bn, bd in pairs(sideBtns) do
            if bn == name then
                -- Active state: ember glow
                tw(bd.btn, 0.18, {BackgroundColor3 = C.coal, BackgroundTransparency = 0}):Play()
                tw(bd.stroke, 0.18, {Color = C.ember, Transparency = 0.1}):Play()
                tw(bd.text, 0.18, {TextColor3 = C.spark}):Play()
                tw(bd.icon, 0.18, {TextColor3 = C.flame}):Play()
                tw(bd.bar, 0.18, {BackgroundTransparency = 0}):Play()
            else
                -- Inactive state: recede
                tw(bd.btn, 0.18, {BackgroundColor3 = C.grave, BackgroundTransparency = 0.25}):Play()
                tw(bd.stroke, 0.18, {Color = C.arcane, Transparency = 0.6}):Play()
                tw(bd.text, 0.18, {TextColor3 = C.ash}):Play()
                tw(bd.icon, 0.18, {TextColor3 = C.ash}):Play()
                tw(bd.bar, 0.18, {BackgroundTransparency = 1}):Play()
            end
        end
    end

    sb.MouseButton1Click:Connect(function()
        setActive()
        playSound("rbxassetid://12221976")
    end)
    sb.MouseEnter:Connect(function()
        if pages[name].Visible then return end
        tw(sb, 0.12, {BackgroundColor3 = C.crypt, BackgroundTransparency = 0.1}):Play()
    end)
    sb.MouseLeave:Connect(function()
        if pages[name].Visible then return end
        tw(sb, 0.12, {BackgroundColor3 = C.grave, BackgroundTransparency = 0.25}):Play()
    end)

    return page
end

