local AURA_COOLDOWN = 0.05   -- FIX: rate-limit firetouchinterest, not every PreRender
local lastAuraFire  = 0

uiLibrary:AddToggle("GOD Kill-Aura (Close Range)", function(enabled)
    getgenv().godAuraEnabled = enabled
    if enabled then
        if not getgenv().godAuraConn then
            getgenv().godAuraConn = RunService.Heartbeat:Connect(function()  -- FIX: Heartbeat not PreRender
                if not getgenv().godAuraEnabled then return end
                local now = tick()
                if now - lastAuraFire < AURA_COOLDOWN then return end
                lastAuraFire = now

                local char = LP.Character
                if not char then return end
                local myRoot = char:FindFirstChild("HumanoidRootPart")
                local hum    = char:FindFirstChildOfClass("Humanoid")
                if not (myRoot and hum and hum.Health > 0) then return end

                local tool   = char:FindFirstChildOfClass("Tool")
                if not tool then
                    local bp = LP:FindFirstChild("Backpack")
                    if bp then
                        local t = bp:FindFirstChildOfClass("Tool")
                        if t then hum:EquipTool(t) end
                    end
                    return
                end

                local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
                if not handle then return end
                tool:Activate()

                local myPos = myRoot.Position
                for _, p in ipairs(Players:GetPlayers()) do
                    if isEnemy(p) and p.Character then
                        local ec   = p.Character
                        local eHum = ec:FindFirstChildOfClass("Humanoid")
                        local eRoot= ec:FindFirstChild("HumanoidRootPart") or ec:FindFirstChild("UpperTorso")
                        if eRoot and eHum and eHum.Health > 0 then
                            local off   = myPos - eRoot.Position
                            local distSq= off.X*off.X + off.Y*off.Y + off.Z*off.Z
                            if distSq <= GOD_RANGE_SQ then
                                for _, pt in ipairs({eRoot, ec:FindFirstChild("Head"),
                                    ec:FindFirstChild("UpperTorso"), ec:FindFirstChild("LowerTorso")}) do
                                    if pt and firetouchinterest then
                                        firetouchinterest(handle, pt, 0)
                                        firetouchinterest(handle, pt, 1)
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    else
        if getgenv().godAuraConn then
            getgenv().godAuraConn:Disconnect()
            getgenv().godAuraConn = nil
        end
    end
end, false)

