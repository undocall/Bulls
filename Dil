-- ─── UTILITY BUILDER FUNCTIONS ────────────────────

-- Adds an inner shadow gradient (dark at edges = depth illusion)
local function addDepthGradient(frame, rotation, c1, c2, t1, t2)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   c1 or C.void),
        ColorSequenceKeypoint.new(1,   c2 or C.crypt),
    })
    g.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0,   t1 or 0),
        NumberSequenceKeypoint.new(1,   t2 or 0),
    })
    g.Rotation = rotation or 90
    g.Parent = frame
    return g
end

-- Glowing stroke with gradient
local function addGlowStroke(frame, c1, c2, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1.5
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.LineJoinMode = Enum.LineJoinMode.Round
    -- UIStroke doesn't support gradients directly but we layer on a frame border
    s.Color = c1 or C.arcane
    s.Parent = frame
    return s
end

local function addCorner(frame, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = frame
    return c
end

local function addPadding(frame, top, bottom, left, right)
    local p = Instance.new("UIPadding")
    p.PaddingTop    = UDim.new(0, top    or 6)
    p.PaddingBottom = UDim.new(0, bottom or 6)
    p.PaddingLeft   = UDim.new(0, left   or 6)
    p.PaddingRight  = UDim.new(0, right  or 6)
    p.Parent = frame
    return p
end

local function addListLayout(frame, padding, direction, alignment)
    local l = Instance.new("UIListLayout")
    l.Padding = UDim.new(0, padding or 6)
    l.FillDirection = direction or Enum.FillDirection.Vertical
    l.HorizontalAlignment = alignment or Enum.HorizontalAlignment.Left
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.Parent = frame
    return l
end

-- Tween shorthand
local function tw(obj, t, props, style, dir)
    return TweenService:Create(obj,
        TweenInfo.new(t or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
        props
    )
end

-- Ripple flash on click (subtle brightness pulse)
local function addClickRipple(btn, frame)
    local flash = Instance.new("Frame")
    flash.Size = UDim2.new(1, 0, 1, 0)
    flash.BackgroundColor3 = Color3.fromRGB(255, 180, 80)
    flash.BackgroundTransparency = 1
    flash.BorderSizePixel = 0
    flash.ZIndex = frame.ZIndex + 5
    addCorner(flash, 8)
    flash.Parent = frame

    btn.MouseButton1Down:Connect(function()
        flash.BackgroundTransparency = 0.82
        tw(flash, 0.3, {BackgroundTransparency = 1}):Play()
    end)
end

