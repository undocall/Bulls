-- ── HITBOX ────────────────────────────────────────────────────────────────────
local function saveAndExpand(char)
    if not char then return end
    local p = Players:GetPlayerFromCharacter(char)
    if p == LP then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return end

    local isR15 = hum and hum.RigType == Enum.HumanoidRigType.R15

    local targets = {"HumanoidRootPart", "Head"}
    if isR15 then
        for _, n in ipairs({"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftUpperLeg","RightUpperLeg"}) do
            targets[#targets+1] = n
        end
    end

    if not savedHitboxData[char] then savedHitboxData[char] = {} end

    for _, name in ipairs(targets) do
        local part = char:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            -- save original on first expand only
            if not savedHitboxData[char][name] then
                savedHitboxData[char][name] = {
                    size         = part.Size,
                    transparency = part.Transparency,  -- FIX: save real transparency
                    brickcolor   = part.BrickColor,
                    material     = part.Material,
                    cancollide   = part.CanCollide,
                    massless     = part.Massless,
                }
            end
            part.Size         = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
            part.Transparency = hitboxTransp
            part.BrickColor   = name == "Head" and BrickColor.new("Bright red") or BrickColor.new("Dark red")
            part.Material     = Enum.Material.ForceField
            part.CanCollide   = false
            if name == "Head" then part.Massless = true end
        end
    end
end

local function restoreChar(char)
    if not char then return end
    local data = savedHitboxData[char]
    if not data then return end
    for name, orig in pairs(data) do
        local part = char:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            pcall(function()
                part.Size         = orig.size
                part.Transparency = orig.transparency  -- FIX: restore real value
                part.BrickColor   = orig.brickcolor
                part.Material     = orig.material
                part.CanCollide   = orig.cancollide
                if name == "Head" then part.Massless = orig.massless end
            end)
        end
    end
    savedHitboxData[char] = nil
end

local function applyToAll()
    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemy(p) and p.Character then saveAndExpand(p.Character) end
    end
end

local function restoreAll()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then restoreChar(p.Character) end
    end
    savedHitboxData = {}
end

local function toggleHitboxes(enabled)
    hitboxEnabled = enabled
    playSound("rbxassetid://12221976")

    if hitboxConn then hitboxConn:Disconnect() hitboxConn = nil end  -- FIX: proper cleanup

    if enabled then
        applyToAll()
        -- FIX: RunService connection instead of coroutine
        hitboxConn = RunService.Heartbeat:Connect(function()
            if not hitboxEnabled then return end
            applyToAll()
        end)
    else
        restoreAll()
    end
end

-- ── ESP ───────────────────────────────────────────────────────────────────────
local function clearESP(player)
    if espGuis[player] then
        pcall(function() espGuis[player]:Destroy() end)
        espGuis[player] = nil
    end
    if espConns[player] then
        pcall(function() espConns[player]:Disconnect() end)  -- FIX: disconnect render conn
        espConns[player] = nil
    end
end

local function createESP(player)
    clearESP(player)
    if not player or not player.Character or player == LP then return end
    if not isEnemy(player) then return end

    local head    = player.Character:FindFirstChild("Head")
    local root    = player.Character:FindFirstChild("HumanoidRootPart")
    local anchor  = head or root
    if not anchor then return end

    local bg      = Instance.new("BillboardGui")
    bg.Adornee    = anchor
    bg.Size       = UDim2.new(0, 100, 0, 50)
    bg.StudsOffset= Vector3.new(0, 2, 0)
    bg.AlwaysOnTop= true
    bg.Parent     = anchor

    local lbl         = Instance.new("TextLabel", bg)
    lbl.Size          = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3    = Color3.new(1, 0, 0)
    lbl.TextStrokeTransparency= 0
    lbl.Text          = player.Name
    lbl.TextScaled    = true
    lbl.Font          = Enum.Font.SourceSansBold

    espGuis[player] = bg

    local lastT = tick()
    -- FIX: store connection so it can be cleaned up
    espConns[player] = RunService.RenderStepped:Connect(function()
        if not bg or not bg.Parent then
            clearESP(player)
            return
        end
        if tick() - lastT < 0.1 then return end
        lastT = tick()
        local pr = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local lr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if pr and lr then
            local dist = (lr.Position - pr.Position).Magnitude
            local sz   = math.clamp(100 - dist * 0.5, 10, 100)
            bg.Size    = UDim2.new(0, sz, 0, sz * 0.5)
        end
    end)
end

local function toggleESP(enabled)
    espEnabled = enabled
    playSound("rbxassetid://12221976")
    if enabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if isEnemy(p) then createESP(p) end
        end
    else
        for p, _ in pairs(espGuis) do clearESP(p) end
    end
end

-- ── PLAYER TRACKING ───────────────────────────────────────────────────────────
local function trackPlayer(player)
    if not player then return end
    if not isEnemy(player) then return end

    player.CharacterAdded:Connect(function(char)
        task.wait(1)
        local hum = char:WaitForChild("Humanoid")
        hum.HealthChanged:Connect(function()
            if hitboxEnabled then
                if hum.Health > 0 then saveAndExpand(char) else restoreChar(char) end
            end
        end)
        if hitboxEnabled then saveAndExpand(char) end
        if espEnabled     then createESP(player)   end
    end)

    if player.Character then
        if hitboxEnabled then saveAndExpand(player.Character) end
        if espEnabled     then createESP(player)              end
    end
end

for _, p in ipairs(Players:GetPlayers()) do trackPlayer(p) end
Players.PlayerAdded:Connect(trackPlayer)
Players.PlayerRemoving:Connect(function(p) clearESP(p) end)

