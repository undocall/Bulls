-- ── GLOBAL AURA — FIX: no longer teleports to every enemy every frame ────────
-- now: teleport to ONE random enemy, strike, return — with 0.08s min gap
local GLOBAL_STRIKE_CD = 0.08
local lastGlobalStrike = 0

uiLibrary:AddToggle("Global Autohit (Cross-map)", function(enabled)
    getgenv().globalAuraEnabled = enabled
    if enabled then
        if not getgenv().globalAuraConn then
            getgenv().globalAuraConn = RunService.Heartbeat:Connect(function()
                if not getgenv().globalAuraEnabled then return end
                local now = tick()
                if now - lastGlobalStrike < GLOBAL_STRIKE_CD then return end
                lastGlobalStrike = now

                local char = LP.Character
                if not char then return end
                local myRoot = char:FindFirstChild("HumanoidRootPart")
                local hum    = char:FindFirstChildOfClass("Humanoid")
                if not (myRoot and hum and hum.Health > 0) then return end

                local origin = myRoot.CFrame

                -- pick ONE target this tick, cycle through them
                local enemies = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    if isEnemy(p) and p.Character then
                        local eHum  = p.Character:FindFirstChildOfClass("Humanoid")
                        local eRoot = p.Character:FindFirstChild("HumanoidRootPart")
                        if eRoot and eHum and eHum.Health > 0 then
                            local off = origin.Position - eRoot.Position
                            if off.X*off.X+off.Y*off.Y+off.Z*off.Z <= GLOBAL_RANGE_SQ then
                                enemies[#enemies+1] = {root = eRoot, char = p.Character}
                            end
                        end
                    end
                end

                if #enemies == 0 then return end
                local target = enemies[math.random(#enemies)]

                local tool   = char:FindFirstChildOfClass("Tool")
                local handle = tool and (tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart"))

                myRoot.CFrame = target.root.CFrame * CFrame.new(0,0,1)
                myRoot.AssemblyAngularVelocity = Vector3.new(100000,100000,100000)

                if tool and handle then
                    tool:Activate()
                    if firetouchinterest then
                        firetouchinterest(handle, target.root, 0)
                        firetouchinterest(handle, target.root, 1)
                    end
                end

                task.wait(0.01)
                myRoot.AssemblyAngularVelocity = Vector3.zero
                myRoot.AssemblyLinearVelocity  = Vector3.zero
                myRoot.CFrame = origin
            end)
        end
    else
        if getgenv().globalAuraConn then
            getgenv().globalAuraConn:Disconnect()
            getgenv().globalAuraConn = nil
        end
    end
end, false)

