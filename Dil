local noFallEnabled = false
local noFallConn    = nil

local function executeACR(char, hum, hrp)
    if not (char and hum and hrp) then return end
    pcall(function()
        hrp.Anchored = true
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hum.PlatformStand = false
        hum.Sit           = false
        local pos  = hrp.Position
        local look = hrp.CFrame.LookVector
        local flat = Vector3.new(look.X,0,look.Z)
        if flat.Magnitude < 0.1 then flat = Vector3.new(0,0,-1) end
        flat = flat.Unit
        hrp.CFrame = CFrame.new(pos + Vector3.new(0,2.5,0), pos + Vector3.new(0,2.5,0) + flat)
        hum:ChangeState(Enum.HumanoidStateType.Freefall)
        task.wait(0.05)
        hrp.Anchored = false
        hum.Jump     = true
    end)
end

local function setStates(hum, on)
    if not hum then return end
    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, not on)
    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,     not on)
end

local function toggleAntiFling(on)
    noFallEnabled = on
    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")

    if on then
        flingBtn.Text       = "Anti-Fling: ON"
        flingBtn.TextColor3 = Color3.fromRGB(75,255,75)
        fStroke.Color       = Color3.fromRGB(75,255,75)
        executeACR(char, hum, hrp)
        setStates(hum, true)
        if not noFallConn then
            noFallConn = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local c = LP.Character
                    if not c then return end
                    local r = c:FindFirstChild("HumanoidRootPart")
                    local h = c:FindFirstChildOfClass("Humanoid")
                    if r and h then
                        local lv = r.AssemblyLinearVelocity
                        local av = r.AssemblyAngularVelocity
                        if Vector3.new(lv.X,0,lv.Z).Magnitude > 150 or av.Magnitude > 75 then
                            executeACR(c, h, r)
                        end
                        if h.PlatformStand then
                            h.PlatformStand = false
                            h.Jump          = true
                        end
                    end
                end)
            end)
        end
    else
        flingBtn.Text       = "Anti-Fling: OFF"
        flingBtn.TextColor3 = Color3.fromRGB(255,75,75)
        fStroke.Color       = Color3.fromRGB(255,75,75)
        if noFallConn then noFallConn:Disconnect() noFallConn = nil end
        setStates(hum, false)
        executeACR(char, hum, hrp)
    end
end

