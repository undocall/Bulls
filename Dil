local function syncReopenToPanel()
    local px, psz, rsz = mainPanel.Position, mainPanel.Size, reopenBtn.Size
    reopenBtn.Position = UDim2.new(
        px.X.Scale, px.X.Offset + (psz.X.Offset - rsz.X.Offset) / 2,
        px.Y.Scale, px.Y.Offset + (psz.Y.Offset - rsz.Y.Offset) / 2
    )
end

local function syncPanelToReopen()
    local rx, rsz, psz = reopenBtn.Position, reopenBtn.Size, mainPanel.Size
    mainPanel.Position = UDim2.new(
        rx.X.Scale, rx.X.Offset - (psz.X.Offset - rsz.X.Offset) / 2,
        rx.Y.Scale, rx.Y.Offset - (psz.Y.Offset - rsz.Y.Offset) / 2
    )
end

