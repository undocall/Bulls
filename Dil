-- ═══════════ FLY V3 (forward declarations for cross-references) ═══════════
local flyV3Active = false
local flyV3Speed = 1
local flyV3UpHeld = false
local flyV3DownHeld = false

-- ═══════════ INVISIBLE ═══════════
local invisibleEnabled = false
local invisibleParts = {}
local invisibleConnection = nil

local function setupInvisibleParts()
    invisibleParts = {}
    local char = lp.Character
    if not char then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d.Transparency == 0 then table.insert(invisibleParts, d) end
    end
end

local function startInvisible()
    if invisibleEnabled then return end
    invisibleEnabled = true
    if flyV3Active then stopFlyV3() end
    setupInvisibleParts()
    for _, part in ipairs(invisibleParts) do pcall(function() part.Transparency = 0.5 end) end
    if not invisibleConnection then
        invisibleConnection = RunService.Heartbeat:Connect(function()
            if not invisibleEnabled then return end
            local c = lp.Character
            if not c then return end
            local h = c:FindFirstChildOfClass("Humanoid")
            local r = c:FindFirstChild("HumanoidRootPart")
            if not h or not r then return end
            pcall(function()
                local origCF = r.CFrame
                local origOffset = h.CameraOffset
                local downCF = origCF * CFrame.new(0, -200000, 0)
                r.CFrame = downCF
                h.CameraOffset = downCF:ToObjectSpace(CFrame.new(origCF.Position)).Position
                RunService.RenderStepped:Wait()
                r.CFrame = origCF
                h.CameraOffset = origOffset
            end)
        end)
    end
end

local function stopInvisible()
    invisibleEnabled = false
    for _, part in ipairs(invisibleParts) do pcall(function() part.Transparency = 0 end) end
    invisibleParts = {}
    if invisibleConnection then invisibleConnection:Disconnect() invisibleConnection = nil end
    local char = lp.Character
    if char then
        local h = char:FindFirstChildOfClass("Humanoid")
        if h then pcall(function() h.CameraOffset = Vector3.zero end) end
    end
end

-- ═══════════ FLY V3 ═══════════
local function startFlyV3()
    if flyV3Active then return end
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if invisibleEnabled then stopInvisible() end
    flyV3Active = true
    disableAllHumanoidStates(hum)
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Swimming) end)
    pcall(function()
        if char:FindFirstChild("Animate") then char.Animate.Disabled = true end
        for _, v in ipairs(hum:GetPlayingAnimationTracks()) do v:AdjustSpeed(0) end
    end)

    for i = 1, flyV3Speed do
        task.spawn(function()
            local hb = RunService.Heartbeat
            while flyV3Active do
                hb:Wait()
                local c = lp.Character
                if not c then break end
                local h = c:FindFirstChildOfClass("Humanoid")
                if not h or not h.Parent then break end
                if h.MoveDirection.Magnitude > 0 then pcall(function() c:TranslateBy(h.MoveDirection) end) end
            end
        end)
    end

    task.spawn(function()
        local isR6 = (hum.RigType == Enum.HumanoidRigType.R6)
        local torso = isR6 and char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        if not torso then flyV3Active = false return end

        local bg = Instance.new("BodyGyro", torso)
        bg.P = 9e4; bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9); bg.CFrame = torso.CFrame
        local bv = Instance.new("BodyVelocity", torso)
        bv.Velocity = Vector3.new(0, 0.1, 0); bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        hum.PlatformStand = true

        while flyV3Active do
            RunService.RenderStepped:Wait()
            local c = lp.Character
            if not c then break end
            local h = c:FindFirstChildOfClass("Humanoid")
            local hrp = c:FindFirstChild("HumanoidRootPart")
            if not h or not hrp or h.Health <= 0 then break end
            if flyV3UpHeld then pcall(function() hrp.CFrame = hrp.CFrame * CFrame.new(0, 1, 0) end)
            elseif flyV3DownHeld then pcall(function() hrp.CFrame = hrp.CFrame * CFrame.new(0, -1, 0) end) end
            bv.Velocity = Vector3.zero
            bg.CFrame = workspace.CurrentCamera.CFrame
        end
        bg:Destroy() bv:Destroy()
        pcall(function() hum.PlatformStand = false; if char:FindFirstChild("Animate") then char.Animate.Disabled = false end end)
    end)
end

local function stopFlyV3()
    flyV3Active = false
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        enableAllHumanoidStates(hum)
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics); hum.PlatformStand = false end)
    end
    pcall(function() if char:FindFirstChild("Animate") then char.Animate.Disabled = false end end)
end

-- ═══════════ HITBOX ═══════════
local function applyHitbox(character)
    if not character then return end
    local player = Players:GetPlayerFromCharacter(character)
    if player and player == lp then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then return end
    local isR15 = humanoid and humanoid.RigType == Enum.HumanoidRigType.R15
    local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso")
    if rootPart then
        if not rootPart:FindFirstChild("OriginalSize") then
            local o = Instance.new("Vector3Value"); o.Name = "OriginalSize"; o.Value = rootPart.Size; o.Parent = rootPart
        end
        rootPart.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
        rootPart.Transparency = hitboxTransparency
        rootPart.BrickColor = BrickColor.new("Dark red")
        rootPart.Material = Enum.Material.ForceField
        rootPart.CanCollide = false
        if isR15 then
            local lt = character:FindFirstChild("LowerTorso")
            if lt then
                if not lt:FindFirstChild("OriginalSize") then
                    local o = Instance.new("Vector3Value"); o.Name = "OriginalSize"; o.Value = lt.Size; o.Parent = lt
                end
                lt.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                lt.Transparency = hitboxTransparency
                lt.BrickColor = BrickColor.new("Dark red")
                lt.Material = Enum.Material.ForceField
                lt.CanCollide = false
            end
        end
    end
    local head = character:FindFirstChild("Head")
    if head then
        if not head:FindFirstChild("OriginalSize") then
            local o = Instance.new("Vector3Value"); o.Name = "OriginalSize"; o.Value = head.Size; o.Parent = head
        end
        head.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
        head.Transparency = hitboxTransparency
        head.BrickColor = BrickColor.new("Bright red")
        head.Material = Enum.Material.ForceField
        head.CanCollide = false
        head.Massless = true
    end
    if isR15 then
        for _, pn in ipairs({"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftUpperLeg","RightUpperLeg"}) do
            local p = character:FindFirstChild(pn)
            if p then
                if not p:FindFirstChild("OriginalSize") then
                    local o = Instance.new("Vector3Value"); o.Name = "OriginalSize"; o.Value = p.Size; o.Parent = p
                end
                p.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                p.Transparency = hitboxTransparency
                p.BrickColor = BrickColor.new("Dark red")
                p.Material = Enum.Material.ForceField
                p.CanCollide = false
            end
        end
    end
end

local function resetHitbox(character)
    if not character then return end
    local player = Players:GetPlayerFromCharacter(character)
    if player and player == lp then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso")
    if rootPart and rootPart:FindFirstChild("OriginalSize") then
        rootPart.Size = rootPart.OriginalSize.Value; rootPart.Transparency = 1; rootPart.BrickColor = BrickColor.new("Medium stone grey"); rootPart.Material = Enum.Material.Plastic; rootPart.CanCollide = true
    end
    local head = character:FindFirstChild("Head")
    if head and head:FindFirstChild("OriginalSize") then
        head.Size = head.OriginalSize.Value; head.Transparency = 1; head.BrickColor = BrickColor.new("Medium stone grey"); head.Material = Enum.Material.Plastic; head.CanCollide = true; head.Massless = false
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local isR15 = humanoid and humanoid.RigType == Enum.HumanoidRigType.R15
    if isR15 then
        for _, pn in ipairs({"LowerTorso","UpperTorso","LeftUpperArm","RightUpperArm","LeftUpperLeg","RightUpperLeg"}) do
            local p = character:FindFirstChild(pn)
            if p and p:FindFirstChild("OriginalSize") then
                p.Size = p.OriginalSize.Value; p.Transparency = 1; p.CanCollide = true; p.BrickColor = BrickColor.new("Medium stone grey"); p.Material = Enum.Material.Plastic
            end
        end
    end
end

local function applyHitboxesToAllPlayers()
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) and player.Character then applyHitbox(player.Character) end
    end
end

local function resetHitboxesOnAllPlayers()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then resetHitbox(player.Character) end
    end
end

local function toggleHitboxes(enabled)
    hitboxEnabled = enabled
    playSound("rbxassetid://12221976")
    if enabled then applyHitboxesToAllPlayers() else resetHitboxesOnAllPlayers() end
end

local function trackPlayer(player)
    if not player then return end
    if isEnemy(player) then
        player.CharacterAdded:Connect(function(character)
            task.wait(1)
            local humanoid = character:WaitForChild("Humanoid")
            local function updateHitboxState()
                if hitboxEnabled then
                    if humanoid.Health > 0 then applyHitbox(character) else resetHitbox(character) end
                end
            end
            updateHitboxState()
            humanoid.HealthChanged:Connect(updateHitboxState)
        end)
        if player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and hitboxEnabled then
                if humanoid.Health > 0 then applyHitbox(player.Character) else resetHitbox(player.Character) end
            end
        end
    end
end

for _, player in ipairs(Players:GetPlayers()) do trackPlayer(player) end
Players.PlayerAdded:Connect(trackPlayer)

-- ═══════════ SMART SEARCH ═══════════
local function smartFind(input)
    if not input or #input < 1 then return nil end
    input = input:lower():gsub("@", "")
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == input or p.DisplayName:lower() == input then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1, #input) == input then return p end
        if p.DisplayName:lower():sub(1, #input) == input then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(input, 1, true) then return p end
        if p.DisplayName:lower():find(input, 1, true) then return p end
    end
    return nil
end

-- ═══════════ MOUNT STRIP & TELEPORT ═══════════
local function stripMount(character)
    if not character then return end
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") then
            local p0, p1 = d.Part0, d.Part1
            if p0 and p1 then
                local n0, n1 = p0.Name:lower(), p1.Name:lower()
                if n0:find("seat") or n1:find("seat") or n0:find("bull") or n1:find("bull") then pcall(function() d:Destroy() end) end
            end
        end
    end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum and hum.Sit then hum.Sit = false; hum.SeatPart = nil; hum.Jump = true end
end

local function teleportToArena(force)
    local char = lp.Character
    if not char then return false, "no character" end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false, "no root" end
    if hum.Health <= 0 then return false, "dead" end
    if not force and hrp.Position.Z < LOBBY_MAX_Z then return false, "in lobby" end

    pcall(function() hum.Sit = false; hum.SeatPart = nil; hum.PlatformStand = false end)
    stripMount(char)
    task.wait(0.1)

    pcall(function()
        hrp.Anchored = true; hrp.CFrame = CFrame.new(ARENA_TELEPORT)
        hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    task.wait(0.15)
    pcall(function() hrp.Anchored = false; hrp.CFrame = CFrame.new(ARENA_TELEPORT) end)

    task.spawn(function() for i = 1, 20 do task.wait(0.05) stripMount(char) end end)
    return true, "ok"
end

