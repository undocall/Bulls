streakLabel.Font                  = Enum.Font.GothamBold
streakLabel.TextSize              = 24
streakLabel.Text                  = ""
streakLabel.Parent                = streakGui

local function flashStreak(text)
    streakLabel.Text             = text
    streakLabel.TextTransparency = 0
    local tw = TweenService:Create(
        streakLabel,
        TweenInfo.new(1.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        {TextTransparency = 1}
    )
    tw:Play()
end

local function getStreakText(n)
    if n >= 10 then return "💀 UNSTOPPABLE x"..n
    elseif n >= 7 then return "🔥 RAMPAGE x"..n
    elseif n >= 5 then return "⚡ KILLING SPREE x"..n
    elseif n >= 3 then return "🐂 BULL RUN x"..n
    else return "Kill x"..n end
end

local trackedHealthConns = {}

local function watchEnemy(player)
    if trackedHealthConns[player] then return end
    local function hookChar(char)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        trackedHealthConns[player] = hum.Died:Connect(function()
            local now = tick()
            if now - lastKillTime < 8 then
                killStreak = killStreak + 1
            else
                killStreak = 1
            end
            lastKillTime = now
            flashStreak(getStreakText(killStreak))
            playSound("rbxassetid://12221976")
        end)
    end
    hookChar(player.Character)
    player.CharacterAdded:Connect(hookChar)
end

for _, p in ipairs(Players:GetPlayers()) do
    if isEnemy(p) then watchEnemy(p) end
end
Players.PlayerAdded:Connect(function(p)
    if isEnemy(p) then watchEnemy(p) end
end)

-- ── 2. GROUND LOCK — kills Y knockback, keeps XZ movement ────────────────────
-- server only sees normal movement, purely client velocity clamp
uiLibrary:AddToggle("Ground Lock (No Knockback)", function(enabled)
    groundLockEnabled = enabled
    if groundLockConn then groundLockConn:Disconnect() groundLockConn = nil end
    if enabled then
        groundLockConn = RunService.Heartbeat:Connect(function()
            local char = LP.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local lv = hrp.AssemblyLinearVelocity
            -- if Y velocity is strong upward (knockback) — clamp it
            if lv.Y > 30 then
                hrp.AssemblyLinearVelocity = Vector3.new(lv.X, math.min(lv.Y, 30), lv.Z)
            end
            -- kill spin always
            local av = hrp.AssemblyAngularVelocity
            if av.Magnitude > 5 then
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    end
end, false)

-- ── 3. FLING SURF — redirect incoming fling toward nearest enemy ──────────────
-- when someone flings you, instead of flying off the island you fly INTO someone
uiLibrary:AddToggle("Fling Surf (Redirect Flings)", function(enabled)
    flingurfEnabled = enabled
    if flingurfConn then flingurfConn:Disconnect() flingurfConn = nil end
    if enabled then
        flingurfConn = RunService.Heartbeat:Connect(function()
            local char = LP.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local lv = hrp.AssemblyLinearVelocity
            local spd = lv.Magnitude
            -- only kick in when we're actually being flung (high speed)
            if spd < 80 then return end

            -- find nearest enemy and redirect velocity toward them
            local myPos   = hrp.Position
            local bestDist= math.huge
            local bestPos = nil

            for _, p in ipairs(Players:GetPlayers()) do
                if isEnemy(p) and p.Character then
                    local eRoot = p.Character:FindFirstChild("HumanoidRootPart")
                    if eRoot then
                        local d = (myPos - eRoot.Position).Magnitude
                        if d < bestDist and d > 1 then
                            bestDist = d
                            bestPos  = eRoot.Position
                        end
                    end
                end
            end

            if bestPos then
                local dir = (bestPos - myPos).Unit
                hrp.AssemblyLinearVelocity = dir * spd  -- keep speed, change direction
            end
        end)
    end
end, false)

-- ── 4. CROWD MAGNET — charge toward densest cluster, not just nearest ─────────
-- finds the position with the most enemies within 20 studs and drives into it
uiLibrary:AddToggle("Crowd Magnet (Brawl Ram)", function(enabled)
    crowdMagnetEnabled = enabled
    if crowdMagnetConn then crowdMagnetConn:Disconnect() crowdMagnetConn = nil end
    if enabled then
        crowdMagnetConn = RunService.Heartbeat:Connect(function()
            local char = LP.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if not (hrp and hum and hum.Health > 0) then return end

            local CLUSTER_RADIUS = 20
            local myPos = hrp.Position

            -- collect enemy positions
            local positions = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if isEnemy(p) and p.Character then
                    local eRoot = p.Character:FindFirstChild("HumanoidRootPart")
                    local eHum  = p.Character:FindFirstChildOfClass("Humanoid")
                    if eRoot and eHum and eHum.Health > 0 then
                        positions[#positions+1] = eRoot.Position
                    end
                end
            end

            if #positions == 0 then return end

            -- score each candidate by how many others are within cluster radius
            local bestScore = -1
            local bestPos   = nil

            for _, candPos in ipairs(positions) do
                local score = 0
                for _, otherPos in ipairs(positions) do
                    if (candPos - otherPos).Magnitude <= CLUSTER_RADIUS then
                        score = score + 1
                    end
                end
                if score > bestScore then
                    bestScore = score
                    bestPos   = candPos
                end
            end

            if bestPos then
                local dir = (bestPos - myPos).Unit
                local bv  = hrp:FindFirstChild("CrowdMagnet_BV")
                if not bv then
                    bv          = Instance.new("BodyVelocity")
                    bv.Name     = "CrowdMagnet_BV"
                    bv.MaxForce = Vector3.new(math.huge,0,math.huge)
                    bv.Parent   = hrp
                end
                bv.Velocity = dir * (hum.WalkSpeed * 3)
            end
        end)
    else
        -- clean up BodyVelocity
        local hrp = getHRP(LP)
        if hrp then
            local bv = hrp:FindFirstChild("CrowdMagnet_BV")
            if bv then bv:Destroy() end
        end
    end
end, false)

-- ── 5. AUTO RESPAWN — instant respawn, no death screen ───────────────────────
uiLibrary:AddToggle("Auto Respawn", function(enabled)
    if autoRespawnConn then autoRespawnConn:Disconnect() autoRespawnConn = nil end
    if enabled then
        local function hookDeath(char)
            local hum = char:WaitForChild("Humanoid")
            hum.Died:Connect(function()
                task.wait(0.1)
                LP:LoadCharacter()
            end)
        end
        if LP.Character then hookDeath(LP.Character) end
        autoRespawnConn = LP.CharacterAdded:Connect(hookDeath)
    end
end, false)

-- ── 6. SPECTATOR ALERT — know when someone's camera is on you ────────────────
-- checks which players have camera subject pointing at your character parts
uiLibrary:AddToggle("Spectator Alert", function(enabled)
    if specAlertConn then specAlertConn:Disconnect() specAlertConn = nil end
    if enabled then
        local lastAlert   = 0
        local lastWatcher = ""
        specAlertConn = RunService.Heartbeat:Connect(function()
            local now = tick()
            if now - lastAlert < 3 then return end  -- alert max every 3s
            local myChar = LP.Character
            if not myChar then return end
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP then
                    -- spectators typically have no character or their cam follows your parts
                    local pChar = p.Character
                    if not pChar then
                        -- spectating someone — rough heuristic: no active character
                        if p.Name ~= lastWatcher then
                            lastWatcher = p.Name
                            lastAlert   = now
                            notify("👁 Spectator Alert", p.Name .. " may be watching you", 3)
                        end
                    end
                end
            end
        end)
    end
end, false)

