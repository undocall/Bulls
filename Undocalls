-- ═══════════ MAIN LOOP ═══════════

local lastRound = nil

task.spawn(function()
    while true do
        local texts = getRoundTexts()
        
        local roundKey = ""
        for _, t in pairs(texts) do roundKey = roundKey .. t end
        
        if roundKey ~= "" and roundKey ~= lastRound then
            lastRound = roundKey
            doRound()
        elseif roundKey == "" and lastRound ~= nil then
            lastRound = nil
            answerL.Text = "Waiting for round..."
            answerL.TextColor3 = Color3.fromRGB(255, 200, 0)
        end
        
        task.wait(1)
    end
end)

