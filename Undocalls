-- ═══════════ PARSE TEXT ═══════════

local function parseObject(text)
    -- patterns: "Name (height to scale)" or "Name (adjust the length)"
    local name = text:gsub("%s*%(.-%)%s*$", ""):lower()
    local dim = "length"
    if text:lower():find("height") then dim = "height" end
    if text:lower():find("length") then dim = "length" end
    
    -- look up in db
    local entry = DB[name]
    if not entry then
        -- try partial match
        for dbName, data in pairs(DB) do
            if name:find(dbName, 1, true) or dbName:find(name, 1, true) then
                entry = data
                break
            end
        end
    end
    
    if entry then
        return name, entry[dim] or entry.length or entry.height
    end
    return name, nil
end

-- ═══════════ FIND THINGS ═══════════

local function getRoundTexts()
    local texts = {}
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return texts end
    
    for _, obj in pairs(playerGui:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Text ~= "" then
            local t = obj.Text
            if t:find("to scale") or t:find("adjust the") then
                table.insert(texts, t)
            end
        end
    end
    return texts
end

local function findSmallerUIScale()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    
    for _, obj in pairs(playerGui:GetDescendants()) do
        if obj.Name == "Smaller" then
            local scale = obj:FindFirstChildWhichIsA("UIScale")
            if scale then return scale end
        end
    end
    return nil
end

local function findSubmitButton()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    
    for _, obj in pairs(playerGui:GetDescendants()) do
        if obj:IsA("TextButton") then
            if obj.Text:lower():find("submit") then
                return obj
            end
        end
    end
    return nil
end

