-- drag
local dragging, dragStart, startPos
titleL.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)
titleL.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ═══════════ LOGIC ═══════════

local autoMode = true
local currentRef, currentRefSize
local currentGuess, currentGuessSize
local correctScale = nil

local function doRound()
    local texts = getRoundTexts()
    currentRef, currentRefSize = nil, nil
    currentGuess, currentGuessSize = nil, nil
    correctScale = nil
    
    for _, t in pairs(texts) do
        if t:lower():find("to scale") then
            local name, size = parseObject(t)
            currentRef = name
            currentRefSize = size
        elseif t:lower():find("adjust") then
            local name, size = parseObject(t)
            currentGuess = name
            currentGuessSize = size
        end
    end
    
    if currentRefSize and currentGuessSize then
        correctScale = currentGuessSize / currentRefSize
        answerL.Text = "Scale: " .. string.format("%.3f", correctScale)
        answerL.TextColor3 = Color3.fromRGB(0, 255, 100)
        infoL.Text = "Ref: " .. currentRef .. " (" .. currentRefSize .. ") | Guess: " .. currentGuess .. " (" .. currentGuessSize .. ")"
        
        if autoMode then
            local uiScale = findSmallerUIScale()
            if uiScale then
                uiScale.Scale = correctScale
                print("Set scale to " .. correctScale)
                
                task.wait(0.5)
                local submit = findSubmitButton()
                if submit then
                    for _, conn in pairs(getconnections(submit.MouseButton1Click)) do
                        conn:Fire()
                    end
                    pcall(function()
                        game:GetService("VirtualInputManager"):SendMouseButtonEvent(
                            submit.AbsolutePosition.X + submit.AbsoluteSize.X/2,
                            submit.AbsolutePosition.Y + submit.AbsoluteSize.Y/2,
                            0, true, game, 1
                        )
                        task.wait(0.05)
                        game:GetService("VirtualInputManager"):SendMouseButtonEvent(
                            submit.AbsolutePosition.X + submit.AbsoluteSize.X/2,
                            submit.AbsolutePosition.Y + submit.AbsoluteSize.Y/2,
                            0, false, game, 1
                        )
                    end)
                    print("Submitted!")
                end
            else
                print("Could not find UIScale in Smaller")
            end
        end
    else
        if currentRef and not currentRefSize then
            answerL.Text = "Unknown: " .. currentRef
            answerL.TextColor3 = Color3.fromRGB(255, 100, 100)
        elseif currentGuess and not currentGuessSize then
            answerL.Text = "Unknown: " .. currentGuess
            answerL.TextColor3 = Color3.fromRGB(255, 100, 100)
        else
            answerL.Text = "Waiting for round..."
            answerL.TextColor3 = Color3.fromRGB(255, 200, 0)
        end
        infoL.Text = "Ref: " .. tostring(currentRef) .. " | Guess: " .. tostring(currentGuess)
    end
end

