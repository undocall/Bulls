-- Anti-Fling / No Fall
local noFallEnabled = false
local noFallConnection

uiLibrary:AddToggle("No Fall (Anti-Fling)", function(enabled)
    noFallEnabled = enabled
    playSound("rbxassetid://12221976")
    
    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if enabled then
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        end
        
        if not noFallConnection then
            noFallConnection = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local character = localPlayer.Character
                    if not character then return end
                    
                    local hrp = character:FindFirstChild("HumanoidRootPart")
                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    
                    if hrp and humanoid then
                        local linVel = hrp.AssemblyLinearVelocity
                        local angVel = hrp.AssemblyAngularVelocity
                        local horizSpeed = Vector3.new(linVel.X, 0, linVel.Z).Magnitude
                        
                        if horizSpeed > 120 or angVel.Magnitude > 60 then
                            hrp.AssemblyLinearVelocity = Vector3.new(0, math.clamp(linVel.Y, -50, 80), 0)
                            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end
                        
                        if humanoid.PlatformStand then
                            humanoid.PlatformStand = false
                        end
                    end
                end)
            end)
        end
    else
        if noFallConnection then
            noFallConnection:Disconnect()
            noFallConnection = nil
        end
        
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
        end
    end
end, false)

-- Humanized TriggerBot (Mobile Optimized)
local triggerBotEnabled = false
local triggerBotConnection
local isTriggering = false

local function executeMobileClick()
    if isTriggering then return end
    isTriggering = true
    
    -- 1. Humanized reaction delay
    task.wait(math.random(20, 50) / 1000) 
    
    local attacked = false
    local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
    
    -- 2. Method A: Search PlayerGui for the Mobile Attack Button and trigger it directly
    if playerGui then
        for _, gui in ipairs(playerGui:GetDescendants()) do
            if (gui:IsA("ImageButton") or gui:IsA("TextButton")) and gui.Visible then
                local name = gui.Name:lower()
                -- Detect common mobile attack button names
                if name:find("attack") or name:find("shoot") or name:find("fire") or name:find("action") or name:find("use") then
                    pcall(function()
                        if typeof(firesignal) == "function" then
                            firesignal(gui.Activated)
                            firesignal(gui.MouseButton1Down)
                            task.wait(0.02)
                            firesignal(gui.MouseButton1Up)
                        end
                    end)
                    
                    -- Also simulate touch at the button's exact position
                    pcall(function()
                        local pos = gui.AbsolutePosition
                        local size = gui.AbsoluteSize
                        local tapX = pos.X + (size.X / 2)
                        local tapY = pos.Y + (size.Y / 2)
                        VirtualInputManager:SendTouchEvent(0, Enum.UserInputState.Begin, tapX, tapY, game)
                        task.wait(0.02)
                        VirtualInputManager:SendTouchEvent(0, Enum.UserInputState.End, tapX, tapY, game)
                    end)
                    
                    attacked = true
                    break
                end
            end
        end
    end
    
    -- 3. Method B: Native Tool Activation
    local character = localPlayer.Character
    if character then
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            pcall(function() 
                tool:Activate() 
            end)
        end
    end
    
    -- 4. Method C: Tap Bottom-Right Screen Area (Fallback for mobile action buttons)
    if not attacked then
        pcall(function()
            local camera = workspace.CurrentCamera
            local viewport = camera.ViewportSize
            -- Targets ~85% across and ~75% down the screen (bottom-right action zone)
            local tapX = viewport.X * 0.85
            local tapY = viewport.Y * 0.75
            
            VirtualInputManager:SendMouseButtonEvent(tapX, tapY, 0, true, game, 1)
            task.wait(0.03)
            VirtualInputManager:SendMouseButtonEvent(tapX, tapY, 0, false, game, 1)
        end)
    end
    
    -- Cooldown between clicks
    task.wait(math.random(60, 130) / 1000)
    isTriggering = false
end

local function checkCrosshairTarget()
    local camera = workspace.CurrentCamera
    local viewportSize = camera.ViewportSize
    local center = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    
    local ray = camera:ViewportPointToRay(center.X, center.Y)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {localPlayer.Character, camera}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true
    
    local result = workspace:Raycast(ray.Origin, ray.Direction * 600, raycastParams)
    
    if result and result.Instance then
        local targetCharacter = result.Instance:FindFirstAncestorOfClass("Model")
        if targetCharacter and targetCharacter:FindFirstChild("Humanoid") and targetCharacter.Humanoid.Health > 0 then
            local targetPlayer = Players:GetPlayerFromCharacter(targetCharacter)
            if targetPlayer and isEnemy(targetPlayer) then
                return true
            end
        end
    end
    return false
end

uiLibrary:AddToggle("TriggerBot (Mobile)", function(enabled)
    triggerBotEnabled = enabled
    playSound("rbxassetid://12221976")
    
    if enabled then
        if not triggerBotConnection then
            triggerBotConnection = RunService.RenderStepped:Connect(function()
