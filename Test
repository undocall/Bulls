end)

-- Health Management System
RunService.Heartbeat:Connect(function()
    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if hum and hum.Health > 0 then
        if ultimateHealthEnabled then
            hum.MaxHealth = math.huge
            hum.Health = math.huge
        elseif fastRecoveryEnabled and hum.Health < hum.MaxHealth then
            if tick() - lastHealTime >= 0.2 then
                hum.Health = math.clamp(hum.Health + 10, 0, hum.MaxHealth)
                lastHealTime = tick()
            end
        end
    end
end)

-- ESP system
local function createESP(player)
    if espGuis[player] then
        espGuis[player]:Destroy()
        espGuis[player] = nil
    end
    
    if not player or not player.Character or player == localPlayer then return end
    
    if isEnemy(player) then
        local head = player.Character:FindFirstChild("Head")
        local rootPart = player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("UpperTorso")
        local targetPart = head or rootPart
        
        if not targetPart then return end
        
        local espGui = Instance.new("BillboardGui")
        espGui.Name = "ESP"
        espGui.Adornee = targetPart
        espGui.Size = UDim2.new(0, 100, 0, 50)
        espGui.StudsOffset = Vector3.new(0, 2, 0)
        espGui.AlwaysOnTop = true
        
        local espLabel = Instance.new("TextLabel", espGui)
        espLabel.Size = UDim2.new(1, 0, 1, 0)
        espLabel.BackgroundTransparency = 1
        espLabel.TextColor3 = Color3.new(1, 0, 0)
        espLabel.TextStrokeTransparency = 0
        espLabel.Text = player.Name
        espLabel.TextScaled = true
        espLabel.Font = Enum.Font.SourceSansBold
        
        espGuis[player] = espGui
        espGui.Parent = targetPart
    end
end

local function toggleESP(enabled)
    espEnabled = enabled
    playSound("rbxassetid://12221976")
    if enabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if isEnemy(player) then
                createESP(player)
            end
        end
    else
        for _, gui in pairs(espGuis) do
            if gui then gui:Destroy() end
        end
        espGuis = {}
    end
end

-- Player tracking system + Hit & Weave Monitor
local function trackPlayer(player)
    if not player then return end
    if isEnemy(player) then
        local function bindCharacter(character)
            local humanoid = character:WaitForChild("Humanoid", 5)
            if not humanoid then return end

            local lastHealth = humanoid.Health
            humanoid.HealthChanged:Connect(function(newHealth)
                if newHealth < lastHealth then
                    local myChar = localPlayer.Character
                    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    local enemyHrp = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso")
                    
                    if myHrp and enemyHrp then
                        local dist = (myHrp.Position - enemyHrp.Position).Magnitude
                        if dist <= 18 then
                            triggerHitAndWeave()
                        end
                    end
                end
                lastHealth = newHealth

                if hitboxEnabled then
                    if newHealth > 0 then applyHitbox(character)
                    else resetHitbox(character) end
                end
            end)

            if espEnabled then createESP(player) end
            if hitboxEnabled and humanoid.Health > 0 then applyHitbox(character) end
        end

        player.CharacterAdded:Connect(bindCharacter)
        if player.Character then bindCharacter(player.Character) end
    end
end

for _, player in ipairs(Players:GetPlayers()) do trackPlayer(player) end
Players.PlayerAdded:Connect(trackPlayer)
Players.PlayerRemoving:Connect(function(player)
    if espGuis[player] then
        espGuis[player]:Destroy()
        espGuis[player] = nil
    end
end)

