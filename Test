-- Smart Air Control (Jump-Brake)
RunService.Heartbeat:Connect(function()
    if not smartAirControlEnabled then return end
    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if hum and hrp and hum:GetState() == Enum.HumanoidStateType.Freefall then
        local vel = hrp.AssemblyLinearVelocity
        local horizVel = Vector3.new(vel.X, 0, vel.Z)
        
        -- If moving fast enough horizontally
        if horizVel.Magnitude > 10 then
            -- Predict where player will be in 0.6 seconds
            local predictionTime = 0.6 
            local predictedPos = hrp.Position + (horizVel * predictionTime)
            
            -- Raycast down to check if there is land
            local raycastParams = RaycastParams.new()
            raycastParams.FilterDescendantsInstances = {char}
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
            raycastParams.IgnoreWater = true
            
            local result = workspace:Raycast(predictedPos, Vector3.new(0, -60, 0), raycastParams)
            
            -- If predicting a fall into the void, kill horizontal momentum
            if not result then
                hrp.AssemblyLinearVelocity = Vector3.new(vel.X * 0.1, vel.Y, vel.Z * 0.1)
            end
        end
    end
end)

-- Heavyweight Anti-Knockback
RunService.Heartbeat:Connect(function()
    if not heavyweightEnabled then return end
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local vel = hrp.AssemblyLinearVelocity
    local horizVel = Vector3.new(vel.X, 0, vel.Z)
    local horizSpeed = horizVel.Magnitude

    if horizSpeed > maxAllowedHorizontalSpeed then
        local extraSpeed = horizSpeed - maxAllowedHorizontalSpeed
        local clampedHoriz = horizVel.Unit * (maxAllowedHorizontalSpeed + (extraSpeed * dampeningFactor))
        hrp.AssemblyLinearVelocity = Vector3.new(clampedHoriz.X, vel.Y, clampedHoriz.Z)
    end
end)

