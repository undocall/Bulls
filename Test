-- NEW FEATURE: Absolute CFrame Resuscitation (ACR)
local function executeACR(char, hum, hrp)
    if not (char and hum and hrp) then return end
    
    pcall(function()
        -- 1. Micro-Anchor to kill all glitched physics and momentum
        hrp.Anchored = true
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        
        -- 2. Strip glitched states
        hum.PlatformStand = false
        hum.Sit = false
        
        -- 3. The CFrame Snap: Lift 2.5 studs up and force perfectly vertical rotation
        local currentPos = hrp.Position
        local lookVector = hrp.CFrame.LookVector
        local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z).Unit
        
        -- Fallback if looking straight up/down
        if flatLook.Magnitude < 0.1 then flatLook = Vector3.new(0, 0, -1) end 
        
        local newPos = currentPos + Vector3.new(0, 2.5, 0)
        hrp.CFrame = CFrame.new(newPos, newPos + flatLook)
        
        -- 4. Force freefall to reset animation rig
        hum:ChangeState(Enum.HumanoidStateType.Freefall)
        
        -- 5. Release back to the game engine
        task.wait(0.05)
        hrp.Anchored = false
        hum.Jump = true
    end)
end

