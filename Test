-- UPDATED: No Fall / Anti-Fling (No Anchoring)
local noFallEnabled = false
local noFallConnection

uiLibrary:AddToggle("No Fall (Anti-Fling)", function(enabled)
    noFallEnabled = enabled
    playSound("rbxassetid://12221976")
    
    if enabled then
        if not noFallConnection then
            noFallConnection = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local char = localPlayer.Character
                    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                        local hrp = char.HumanoidRootPart
                        local hum = char.Humanoid
                        
                        -- Disable states that cause tripping
                        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                        
                        -- Calculate horizontal momentum to ignore normal falling speed
                        local horizontalVel = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z)
                        
                        -- If pushed sideways really fast, or spun really fast (fling glitch)
                        if horizontalVel.Magnitude > 35 or hrp.RotVelocity.Magnitude > 35 then
                            -- Erase horizontal momentum and spin, add a tiny natural jump
                            hrp.Velocity = Vector3.new(0, 15, 0)
                            hrp.RotVelocity = Vector3.new(0, 0, 0)
                        end
                        
                        -- Keep character standing
                        if hum.PlatformStand then hum.PlatformStand = false end
                        if hum.Sit then hum.Sit = false end
                    end
                end)
            end)
        end
    else
        if noFallConnection then
            noFallConnection:Disconnect()
            noFallConnection = nil
        end
        
        pcall(function()
            if localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
                local hum = localPlayer.Character.Humanoid
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
            end
        end)
    end
end, false)
