-- Anti-Fling / No Fall 
local noFallEnabled = false
local noFallConnection

uiLibrary:AddToggle("No Fall (Anti-Fling)", function(enabled)
    noFallEnabled = enabled
    playSound("rbxassetid://12221976")
    
    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if enabled then
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        end
        
        if not noFallConnection then
            noFallConnection = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local character = localPlayer.Character
                    if not character then return end
                    
                    local hrp = character:FindFirstChild("HumanoidRootPart")
                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    
                    if hrp and humanoid then
                        local linVel = hrp.AssemblyLinearVelocity
                        local angVel = hrp.AssemblyAngularVelocity
                        local horizSpeed = Vector3.new(linVel.X, 0, linVel.Z).Magnitude
                        
                        if horizSpeed > 120 or angVel.Magnitude > 60 then
                            hrp.AssemblyLinearVelocity = Vector3.new(0, math.clamp(linVel.Y, -50, 80), 0)
                            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end
                        
                        if humanoid.PlatformStand then
                            humanoid.PlatformStand = false
                        end
                    end
                end)
            end)
        end
    else
        if noFallConnection then
            noFallConnection:Disconnect()
            noFallConnection = nil
        end
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
        end
    end
end, false)

-- Humanized TriggerBot
local triggerBotEnabled = false
local triggerBotConnection
local isTriggering = false

local function executeMobileClick()
    if isTriggering then return end
    isTriggering = true
    
    task.wait(math.random(20, 50) / 1000) 
    
    local character = localPlayer.Character
    if character then
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            pcall(function() tool:Activate() end)
        end
    end
    
    task.wait(math.random(60, 130) / 1000)
    isTriggering = false
end

local function checkCrosshairTarget()
    local camera = workspace.CurrentCamera
    local viewportSize = camera.ViewportSize
    local center = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    
    local ray = camera:ViewportPointToRay(center.X, center.Y)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {localPlayer.Character, camera}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true
    
    local result = workspace:Raycast(ray.Origin, ray.Direction * 600, raycastParams)
    
    if result and result.Instance then
        local targetCharacter = result.Instance:FindFirstAncestorOfClass("Model")
        if targetCharacter and targetCharacter:FindFirstChild("Humanoid") and targetCharacter.Humanoid.Health > 0 then
            local targetPlayer = Players:GetPlayerFromCharacter(targetCharacter)
            if targetPlayer and isEnemy(targetPlayer) then
                return true
            end
        end
    end
    return false
end

uiLibrary:AddToggle("TriggerBot (Mobile)", function(enabled)
    triggerBotEnabled = enabled
    playSound("rbxassetid://12221976")
    
    if enabled then
        if not triggerBotConnection then
            triggerBotConnection = RunService.RenderStepped:Connect(function()
                if triggerBotEnabled and not isTriggering then
                    if checkCrosshairTarget() then
                        task.spawn(executeMobileClick)
                    end
                end
            end)
        end
    else
        if triggerBotConnection then
            triggerBotConnection:Disconnect()
            triggerBotConnection = nil
        end
        isTriggering = false
    end
end, false)
